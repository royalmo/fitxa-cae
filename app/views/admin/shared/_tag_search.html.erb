<% selected_tag ||= nil %>
<% field ||= :tag_id %>
<% query_field ||= :tag_query %>
<% results_id ||= "admin-tag-search-results" %>
<% placeholder ||= t("admin.shared.tag_search.placeholder") %>
<% clear_label ||= t("admin.shared.tag_search.clear") %>
<% disabled = local_assigns.fetch(:disabled, false) %>
<% clearable = local_assigns.fetch(:clearable, true) && !disabled %>
<% auto_submit = local_assigns.fetch(:auto_submit, true) %>
<% hidden_data = { tag_search_target: "tagId" }.merge(local_assigns.fetch(:hidden_data, {})) %>
<% input_data = {
  tag_search_target: "input",
  action: "input->tag-search#search focus->tag-search#search keydown->tag-search#keydown"
} %>

<div
  class="admin-tag-search position-relative"
  data-controller="tag-search"
  data-tag-search-url-value="<%= admin_tag_search_path %>"
  data-tag-search-auto-submit-value="<%= auto_submit %>">
  <%= form.hidden_field field,
    value: (selected_tag&.id).to_s,
    data: hidden_data %>
  <div class="input-group">
    <span class="input-group-text"><%= icon "tag" %></span>
    <div class="<%= class_names("form-control admin-tag-search-field", "has-selected-tag": selected_tag.present?) %>" data-tag-search-target="field">
      <span
        class="admin-tag-search-selection admin-tag-label"
        style="<%= admin_tag_name_style(selected_tag) if selected_tag %>"
        data-tag-search-target="selection"
        aria-hidden="true"
        <%= "hidden" unless selected_tag %>>
        <%= icon "tag", class: "admin-tag-label-icon" %>
        <span data-tag-search-target="selectionLabel"><%= selected_tag&.name %></span>
      </span>

      <%= text_field_tag query_field,
        selected_tag&.name,
        class: "admin-tag-search-input",
        placeholder: placeholder,
        autocomplete: "off",
        disabled: disabled,
        role: "combobox",
        aria: {
          autocomplete: "list",
          controls: results_id,
          expanded: "false"
        },
        data: input_data %>
    </div>
    <% if clearable %>
      <button
        type="button"
        class="btn btn-outline-secondary"
        title="<%= clear_label %>"
        aria-label="<%= clear_label %>"
        data-action="tag-search#clear">
        <%= icon "x" %>
      </button>
    <% end %>
  </div>
  <div
    id="<%= results_id %>"
    class="admin-tag-search-results list-group shadow-sm"
    data-tag-search-target="results"
    role="listbox"
    hidden></div>
</div>
