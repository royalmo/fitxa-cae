<% invalidated_swipe_ids = Array(correction.details&.fetch("invalidated_swipe_ids", nil)).map(&:to_s) %>
<% form_url = correction.persisted? ? admin_correction_path(correction) : admin_corrections_path %>
<% requested_swipes_by_kind = @requested_swipe_rows.group_by { |requested_swipe| requested_swipe["kind"].to_s } %>
<% identity_ready = @identity_ready || correction.persisted? %>
<% form_ready = @form_ready || correction.persisted? %>
<% editable_identity = !correction.persisted? %>
<% modification_form = correction.persisted? %>
<% review_confirmation_modal_id = "correction_review_confirmation_modal_#{correction.id}" if modification_form %>
<% submit_icon_name = "check" %>
<% submit_label = modification_form ? t("admin.corrections.form.approve_with_modifications") : t("admin.corrections.form.create_and_approve") %>
<% submit_submitting_label = modification_form ? t("admin.corrections.form.approving_with_modifications") : t("admin.corrections.form.creating_and_approving") %>
<% correction_form_actions = [
  "input->correction-form#dismissErrors",
  "change->correction-form#dismissErrors",
  "focusout->correction-form#sortRequestedSwipeColumn"
] %>
<% correction_form_actions << "submit->correction-form#confirmReviewSubmission" if modification_form %>
<% correction_form_data = {
  controller: "correction-form",
  correction_form_day_url_value: day_admin_corrections_path,
  correction_form_update_url_value: editable_identity,
  correction_form_entries_label_value: t("admin.corrections.form.entries"),
  correction_form_exits_label_value: t("admin.corrections.form.exits"),
  correction_form_request_entry_label_value: t("admin.corrections.form.request_entry"),
  correction_form_request_exit_label_value: t("admin.corrections.form.request_exit"),
  correction_form_existing_swipes_label_value: t("admin.corrections.form.swipes"),
  correction_form_entry_icon_value: icon("log-in", class: "correction-existing-swipe-kind-icon"),
  correction_form_exit_icon_value: icon("log-out", class: "correction-existing-swipe-kind-icon"),
  correction_form_keep_swipe_label_value: t("admin.corrections.form.keep_swipe"),
  correction_form_remove_swipe_label_value: t("admin.corrections.form.invalidate"),
  correction_form_remove_requested_swipe_label_value: t("admin.corrections.form.remove_requested_swipe"),
  correction_form_keep_swipe_icon_value: icon("rotate-ccw", class: "correction-existing-swipe-state-icon"),
  correction_form_remove_swipe_icon_value: icon("trash-2", class: "correction-existing-swipe-state-icon"),
  correction_form_requested_remove_icon_value: icon("trash-2", class: "correction-existing-swipe-state-icon"),
  correction_form_add_icon_value: icon("plus", class: "correction-requested-swipe-add-icon"),
  correction_form_invalidated_swipe_name_value: "swipe_correction[invalidated_swipe_ids][]",
  correction_form_requested_kind_name_value: "swipe_correction[requested_swipes][][kind]",
  correction_form_requested_time_name_value: "swipe_correction[requested_swipes][][hour]",
  action: correction_form_actions.join(" ")
} %>
<% if modification_form %>
  <% correction_form_data.merge!(
    correction_form_initial_invalidated_swipe_ids_value: invalidated_swipe_ids.compact_blank.sort.to_json,
    correction_form_initial_requested_swipes_value: @requested_swipe_rows.map { |requested_swipe|
      {
        kind: requested_swipe["kind"].to_s,
        hour: requested_swipe["hour"].to_s.first(5)
      }
    }.sort_by { |requested_swipe| [ requested_swipe[:hour], requested_swipe[:kind] ] }.to_json,
    correction_form_modified_review_message_value: t("admin.corrections.form.modified_review_confirmation"),
    correction_form_unmodified_review_message_value: t("admin.corrections.form.unmodified_review_confirmation"),
    correction_form_review_confirmation_modal_id_value: review_confirmation_modal_id
  ) %>
<% end %>

<% if correction.errors.any? %>
  <div class="alert alert-danger error-summary">
    <strong><%= t("admin.corrections.form.error_title") %></strong>
    <ul class="mb-0 mt-2">
      <% correction.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: correction, url: form_url, data: correction_form_data do |form| %>
  <%= hidden_field_tag "swipe_correction[server_updated_at]",
    @server_updated_at,
    data: { correction_form_target: "serverUpdatedAt" } %>

  <section class="card shadow-sm">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12 col-lg-9">
          <%= form.label :employee_id, t("admin.corrections.form.employee"), class: "form-label" %>
          <%= render "admin/shared/employee_search",
            form: form,
            field: :employee_id,
            query_field: :employee_query,
            selected_employee: correction.employee,
            placeholder: t("admin.corrections.form.employee_search_placeholder"),
            clear_label: t("admin.corrections.form.clear_employee"),
            results_id: "admin-correction-form-employee-results",
            auto_submit: false,
            disabled: !editable_identity,
            hidden_data: {
              correction_form_target: "employeeId",
              action: "change->correction-form#loadDay"
            } %>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <%= form.label :day, t("admin.corrections.form.day"), class: "form-label" %>
          <% if editable_identity %>
            <%= form.date_field :day,
              value: correction.day&.iso8601,
              class: "form-control",
              data: {
                correction_form_target: "date",
                action: "change->correction-form#loadDay"
              } %>
          <% else %>
            <%= form.date_field :day, value: correction.day&.iso8601, class: "form-control", disabled: true %>
            <%= form.hidden_field :day, value: correction.day&.iso8601, data: { correction_form_target: "date" } %>
          <% end %>
        </div>
      </div>

      <hr>

      <div class="admin-calendar-empty py-4" data-correction-form-target="emptyPrompt" <%= "hidden" if identity_ready %>>
        <%= icon "square-pen" %>
        <p class="small"><%= t("admin.corrections.form.select_employee_day_empty") %></p>
      </div>

      <div class="admin-calendar-empty py-4" data-correction-form-target="loadingPrompt" hidden>
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <p class="small"><%= t("admin.corrections.form.loading_day") %></p>
      </div>

      <div class="mb-4" data-correction-form-target="existingCorrectionPrompt" <%= "hidden" unless @existing_day_correction %>>
        <% if @existing_day_correction %>
          <%= render "existing_correction_prompt", correction: @existing_day_correction %>
        <% end %>
      </div>

      <div data-correction-form-target="formContent" <%= "hidden" unless form_ready %>>
        <div class="row g-4">
          <div class="col-12">
            <div class="admin-correction-swipes">
              <div class="correction-existing-swipes" data-correction-form-target="existingSwipes">
                <div class="correction-swipe-table" role="group" aria-label="<%= t("admin.corrections.form.swipes") %>">
                  <% [
                    { kind: "entry", label: t("admin.corrections.form.entries"), request_label: t("admin.corrections.form.request_entry") },
                    { kind: "exit", label: t("admin.corrections.form.exits"), request_label: t("admin.corrections.form.request_exit") }
                  ].each do |column| %>
                    <% column_swipes = @day_swipes.select { |swipe| swipe.kind == column[:kind] } %>

                    <div class="correction-swipe-column" data-kind="<%= column[:kind] %>">
                      <div class="correction-swipe-column-header"><%= column[:label] %></div>
                      <div class="correction-swipe-column-list">
                        <% column_swipes.each do |swipe| %>
                          <div class="correction-swipe-table-cell">
                            <label class="correction-existing-swipe" data-kind="<%= swipe.kind %>">
                              <%= check_box_tag "swipe_correction[invalidated_swipe_ids][]", swipe.id, invalidated_swipe_ids.include?(swipe.id.to_s), class: "visually-hidden" %>
                              <span class="correction-existing-swipe-main">
                                <%= icon clocking_icon_name(swipe.kind), title: clocking_kind_text(swipe.kind), class: "correction-existing-swipe-kind-icon" %>
                                <span class="correction-existing-swipe-copy">
                                  <strong><%= l(swipe.swipe_at, format: :hour_minute) %></strong>
                                </span>
                              </span>
                              <span class="correction-existing-swipe-state">
                                <span class="correction-existing-swipe-keep" title="<%= t("admin.corrections.form.invalidate") %>" aria-label="<%= t("admin.corrections.form.invalidate") %>">
                                  <%= icon "trash-2", class: "correction-existing-swipe-state-icon" %>
                                </span>
                                <span class="correction-existing-swipe-remove" title="<%= t("admin.corrections.form.keep_swipe") %>" aria-label="<%= t("admin.corrections.form.keep_swipe") %>">
                                  <%= icon "rotate-ccw", class: "correction-existing-swipe-state-icon" %>
                                </span>
                              </span>
                            </label>
                          </div>
                        <% end %>

                        <% Array(requested_swipes_by_kind[column[:kind]]).each do |requested_swipe| %>
                          <div class="correction-swipe-table-cell correction-swipe-request-cell">
                            <div class="correction-existing-swipe correction-requested-swipe" data-kind="<%= column[:kind] %>">
                              <span class="correction-existing-swipe-main">
                                <%= icon clocking_icon_name(column[:kind]), title: clocking_kind_text(column[:kind]), class: "correction-existing-swipe-kind-icon" %>
                                <span class="correction-existing-swipe-copy">
                                  <%= hidden_field_tag "swipe_correction[requested_swipes][][kind]", column[:kind] %>
                                  <%= time_field_tag "swipe_correction[requested_swipes][][hour]",
                                    requested_swipe["hour"].to_s.first(5),
                                    aria: { label: column[:request_label] } %>
                                </span>
                              </span>
                              <%= button_tag type: :button,
                                class: "correction-existing-swipe-state correction-requested-swipe-remove",
                                title: t("admin.corrections.form.remove_requested_swipe"),
                                aria: { label: t("admin.corrections.form.remove_requested_swipe") },
                                data: { action: "correction-form#removeRequestedSwipe" } do %>
                                <%= icon "trash-2", class: "correction-existing-swipe-state-icon" %>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>

                      <%= button_tag type: :button,
                        class: "correction-requested-swipe-add",
                        data: { action: "correction-form#addRequestedSwipe", kind: column[:kind] } do %>
                        <%= icon "plus", class: "correction-requested-swipe-add-icon" %>
                        <span><%= column[:request_label] %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% if modification_form %>
          <div class="d-flex flex-column gap-3 mt-3">
            <div>
              <%= label_tag "swipe_correction_requester_comments",
                t("admin.corrections.form.employee_note"),
                class: "form-label" %>
              <%= text_area_tag "swipe_correction[requester_comments]",
                correction.requester_comments.presence || t("admin.corrections.form.no_employee_note"),
                id: "swipe_correction_requester_comments",
                rows: 3,
                class: "form-control admin-correction-readonly-comment",
                disabled: true %>
            </div>
            <div>
              <%= form.label :validator_comments, t("admin.corrections.form.hr_note"), class: "form-label" %>
              <%= form.text_area :validator_comments,
                rows: 3,
                class: "form-control",
                data: { correction_form_target: "comment" } %>
            </div>
          </div>
        <% else %>
          <div class="mt-4">
            <%= form.label :requester_comments, t("admin.corrections.form.note"), class: "form-label" %>
            <%= form.text_area :requester_comments,
              rows: 3,
              class: "form-control",
              data: { correction_form_target: "comment" } %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <div class="d-flex flex-wrap gap-2 mt-4" data-correction-form-target="submitActions" <%= "hidden" unless form_ready %>>
    <%= link_to admin_corrections_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
      <%= icon "x" %>
      <span><%= t("shared.cancel") %></span>
    <% end %>
    <% if modification_form %>
      <%= button_tag type: :button,
        class: "btn btn-primary d-inline-flex align-items-center gap-2",
        data: {
          action: "correction-form#prepareReviewConfirmation",
          bs_toggle: "modal",
          bs_target: "##{review_confirmation_modal_id}"
        } do %>
        <%= icon submit_icon_name %>
        <span><%= submit_label %></span>
      <% end %>
    <% else %>
      <%= button_tag type: :submit, class: "btn btn-primary d-inline-flex align-items-center gap-2", data: { submitting_label: submit_submitting_label } do %>
        <%= icon submit_icon_name %>
        <span><%= submit_label %></span>
      <% end %>
    <% end %>
  </div>

  <% if modification_form %>
    <div class="modal fade" id="<%= review_confirmation_modal_id %>" tabindex="-1" aria-labelledby="<%= review_confirmation_modal_id %>_label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="<%= review_confirmation_modal_id %>_label">
              <%= t("admin.corrections.form.review_confirmation_title") %>
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.cancel") %>"></button>
          </div>
          <div class="modal-body">
            <p class="mb-0" data-correction-form-target="reviewConfirmationBody">
              <%= t("admin.corrections.form.unmodified_review_confirmation") %>
            </p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
              <%= t("shared.cancel") %>
            </button>
            <%= button_tag type: :submit,
              class: "btn btn-primary",
              data: {
                correction_form_confirmed: "true",
                submitting_label: submit_submitting_label
              } do %>
              <%= t("admin.corrections.form.review_confirmation_confirm") %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
