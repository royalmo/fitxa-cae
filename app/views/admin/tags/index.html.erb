<% content_for :title, t(".title") %>
<% pagination_path = ->(page) { admin_tags_path(request.query_parameters.except("page").merge(page: page)) } %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "tags", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>
  <button type="button"
    class="btn btn-primary d-inline-flex align-items-center gap-2"
    data-bs-toggle="modal"
    data-bs-target="#<%= admin_tag_form_modal_id(@new_tag) %>">
    <%= icon "plus" %>
    <span><%= t(".new_tag") %></span>
  </button>
</div>

<div data-controller="list-loading">
  <div class="mb-3">
    <%= form_with url: admin_tags_path,
      method: :get,
      class: "admin-tags-filter-form d-flex flex-column flex-lg-row align-items-stretch gap-2 w-100 mb-2",
      data: { action: "submit->list-loading#showLoading" } do |form| %>
      <div class="input-group flex-grow-1">
        <%= form.label :q, t("shared.search"), class: "form-label visually-hidden" %>
        <%= form.search_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "form-control" %>
        <%= button_tag type: :submit, class: "btn btn-outline-secondary", title: t("shared.search"), aria: { label: t("shared.search") } do %>
          <%= icon "search" %>
        <% end %>
      </div>
      <fieldset class="admin-tags-status-filter btn-group" role="group" aria-label="<%= t(".status") %>">
        <% [[t(".all_statuses"), ""], [t(".active_statuses"), "active"], [t(".disabled_statuses"), "disabled"]].each do |(label, value)| %>
          <% option_id = "tag_status_#{value.presence || "all"}" %>
          <%= form.radio_button :status,
            value,
            id: option_id,
            checked: params[:status].to_s == value,
            class: "btn-check",
            data: { action: "change->list-loading#filter" } %>
          <%= form.label :status, label, for: option_id, class: "btn btn-outline-secondary" %>
        <% end %>
      </fieldset>
    <% end %>

    <div class="text-center">
      <%= render "admin/shared/result_count",
        count: @admin_records_count,
        range_start: @admin_records_range_start,
        range_end: @admin_records_range_end %>
    </div>
  </div>

  <div data-list-loading-target="results">
    <section class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="admin-tags-status-column"><%= t(".status") %></th>
              <th><%= t(".name") %></th>
              <th><%= t(".employees") %></th>
              <th class="text-end"><%= t("shared.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @tags.each do |tag| %>
              <% tag_status = admin_tag_status(tag) %>
              <% activation_action = admin_tag_activation_action(tag) %>
              <% activation_modal_id = admin_tag_activation_modal_id(tag) %>
              <% employees_count = admin_tag_employees_count(tag, @employee_counts_by_tag_id) %>
              <% employees_count_label = admin_tag_employees_count_label(tag, employees_count) %>
              <tr class="<%= class_names("admin-tag-row", "is-inactive": tag_status == :disabled) %>">
                <td class="admin-tags-status-column">
                  <span class="<%= admin_tag_status_class(tag_status) %>">
                    <%= icon admin_tag_status_icon(tag_status), class: "admin-badge-icon" %>
                    <span><%= admin_tag_status_text(tag_status) %></span>
                  </span>
                </td>
                <td>
                  <%= render "label", tag: tag %>
                </td>
                <td>
                  <%= link_to admin_employees_path(tag_id: tag.id),
                    class: "admin-tag-employees-count",
                    title: employees_count_label,
                    aria: { label: employees_count_label } do %>
                    <%= icon "users", class: "admin-tag-employees-count-icon" %>
                    <span><%= employees_count %></span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex align-items-center justify-content-end gap-1">
                    <button type="button"
                      class="<%= admin_tag_activation_button_class(tag) %>"
                      title="<%= t("admin.tags.activation.#{activation_action}.button", name: tag.name) %>"
                      aria-label="<%= t("admin.tags.activation.#{activation_action}.button", name: tag.name) %>"
                      data-bs-toggle="modal"
                      data-bs-target="#<%= activation_modal_id %>">
                      <%= icon admin_tag_activation_icon(tag) %>
                    </button>

                    <button type="button"
                      class="btn btn-sm btn-outline-secondary admin-row-action"
                      title="<%= t("admin.tags.form.edit_button", name: tag.name) %>"
                      aria-label="<%= t("admin.tags.form.edit_button", name: tag.name) %>"
                      data-bs-toggle="modal"
                      data-bs-target="#<%= admin_tag_form_modal_id(tag) %>">
                      <%= icon "pencil" %>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% @tags.each do |tag| %>
        <%= render "form_modal", tag: tag, open: @open_tag_form == tag %>
        <%= render "activation_modal", tag: tag, action: admin_tag_activation_action(tag) %>
      <% end %>

      <%= render "form_modal", tag: @new_tag, open: @open_tag_form == @new_tag %>

      <% if @tags.empty? %>
        <div class="card-body text-center text-body-secondary">
          <%= t(".empty") %>
        </div>
      <% end %>
    </section>

    <%= render "admin/shared/pagination",
      page: @admin_page,
      total_pages: @admin_total_pages,
      previous_page: @admin_previous_page,
      next_page: @admin_next_page,
      path: pagination_path %>
  </div>

  <%= render "admin/shared/list_loading" %>
</div>
