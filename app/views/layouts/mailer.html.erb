<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>

  <body style="<%= mailer_style(:body) %>">
    <div style="<%= mailer_style(:shell) %>">
      <div style="<%= mailer_style(:panel) %>">
        <div style="<%= mailer_style(:header) %>">
          <% logo_url = mailer_logo_url %>
          <%= link_to mailer_app_url, style: mailer_style(:brand) do %>
            <span style="<%= mailer_style(:brand_part) %>"><%= app_brand_prefix %></span>
            <% if logo_url.present? %>
              <% logo_dimensions = mailer_logo_dimensions %>
              <% logo_attributes = {
                alt: app_brand_suffix,
                height: logo_dimensions.fetch(:height),
                style: mailer_style(:logo)
              } %>
              <% logo_attributes[:width] = logo_dimensions.fetch(:width) if logo_dimensions[:width] %>
              <%= image_tag logo_url, logo_attributes %>
            <% elsif app_brand_suffix.present? %>
              <span style="<%= mailer_style(:brand_part) %>"><%= app_brand_suffix %></span>
            <% end %>
          <% end %>
        </div>

        <div style="<%= mailer_style(:content) %>">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
