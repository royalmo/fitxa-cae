<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding-bottom: 18px;
        color: #172033;
        font-family: "Liberation Sans", Arial, sans-serif;
        font-size: 10.5px;
        line-height: 1.35;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        margin-bottom: 4px;
        color: #111827;
        font-size: 22px;
      }

      h2 {
        margin-bottom: 8px;
        color: #111827;
        font-size: 14px;
      }

      h3 {
        margin-bottom: 4px;
        font-size: 11px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 5px 6px;
        border-bottom: 1px solid #d8dee8;
        text-align: left;
        vertical-align: top;
      }

      th {
        color: #4b5563;
        background: #f3f5f8;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .report-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        padding-bottom: 14px;
        border-bottom: 2px solid #e30613;
        margin-bottom: 16px;
      }

      .report-brand {
        color: #e30613;
        font-size: 13px;
        font-weight: 700;
      }

      .report-logo {
        display: inline-flex;
        align-items: flex-start;
        gap: 2px;
        white-space: nowrap;
      }

      .report-logo-with-text-suffix {
        gap: 0;
      }

      .report-logo-fitxa {
        color: #e30613;
        font-size: 24px;
        font-weight: 900;
        line-height: 1;
      }

      .report-logo-image {
        display: block;
        width: auto;
        height: 34px;
        object-fit: contain;
      }

      .report-logo-text-suffix {
        color: #e30613;
        font-size: 24px;
        font-weight: 900;
        letter-spacing: 0;
        line-height: 1;
      }

      .report-summary-header {
        align-items: center;
      }

      .report-summary-title {
        margin: 0;
        color: #000000;
        font-size: 26px;
        font-weight: 800;
        line-height: 1.1;
        text-align: right;
      }

      .report-employee-period {
        color: #000000;
        font-size: 20px;
        font-weight: 800;
        line-height: 1.1;
        text-align: right;
      }

      .report-employee-metadata {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 99%;
      }

      .report-employee-contact {
        flex: 1 1 auto;
        min-width: 0;
      }

      .report-employee-tags {
        flex: 0 1 48%;
        justify-content: flex-end;
        text-align: right;
      }

      .report-period {
        color: #4b5563;
        font-size: 11px;
      }

      .report-muted {
        color: #6b7280;
      }

      .report-kpis {
        display: flex;
        gap: 8px;
        width: 99%;
        margin-bottom: 16px;
      }

      .report-kpi {
        flex: 1 1 0;
        min-width: 0;
        padding: 9px;
        border: 1px solid #d8dee8;
        border-radius: 6px;
        background: #fafbfc;
      }

      .report-kpi-label {
        margin-bottom: 3px;
        color: #6b7280;
        font-size: 8.5px;
        text-transform: uppercase;
      }

      .report-kpi-value {
        font-size: 15px;
        font-weight: 700;
      }

      .report-section {
        margin-bottom: 16px;
      }

      .report-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
      }

      .report-tag {
        display: inline-block;
        padding: 2px 6px;
        border: 1px solid #d8dee8;
        border-radius: 999px;
        color: #4b5563;
        background: #f8fafc;
        font-size: 9px;
      }

      .report-swipe {
        display: inline-block;
        margin-right: 6px;
        white-space: nowrap;
      }

      .report-swipe-entry {
        color: #166534;
      }

      .report-swipe-exit {
        color: #9a3412;
      }

      .report-forged {
        color: #6b7280;
        font-style: italic;
      }

      .report-text-end {
        text-align: right;
      }

      .report-nowrap {
        white-space: nowrap;
      }

      .report-duration-zero {
        color: #e30613;
        font-weight: 700;
      }

      .report-generation-footer {
        position: fixed;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        color: #9ca3af;
        font-size: 8.5px;
        font-style: italic;
      }

      .report-generation-note {
        margin-left: auto;
        text-align: right;
      }

      .report-footer-legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }

      .report-footer-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
      }

      .report-footer-icon,
      .report-swipe-icon,
      .report-correction-icon {
        width: 10px;
        height: 10px;
        stroke-width: 2;
        vertical-align: -1px;
      }

      .report-footer-deleted-example,
      .report-swipe-deleted-time {
        text-decoration: line-through;
      }

      .report-swipe-time {
        position: relative;
        display: inline-block;
      }

      .report-swipe-deleted {
        color: #9ca3af;
      }

      .report-swipe-corrected {
        position: absolute;
        top: -0.2em;
        right: -0.55em;
        width: 7px;
        height: 7px;
        margin-left: 0;
        color: #6b7280;
      }

      .report-empty-day {
        color: #9ca3af;
        opacity: 0.62;
      }
    </style>
  </head>
  <body>
    <%= yield %>
    <% if @report_generated_by.present? && @report_generated_at.present? %>
      <footer class="report-generation-footer">
        <div class="report-footer-legend"><%= yield :report_footer_legend %></div>
        <div class="report-generation-note">
          <%= t("admin.reports.pdf.footer.generated_note",
            manager: manager_display_name(@report_generated_by),
            date: l(@report_generated_at.to_date, format: :long),
            time: l(@report_generated_at, format: :hour_minute)) %>
        </div>
      </footer>
    <% end %>
  </body>
</html>
