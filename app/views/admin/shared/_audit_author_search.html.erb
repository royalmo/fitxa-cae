<% selected_author ||= nil %>
<% field ||= :author %>
<% query_field ||= :author_query %>
<% results_id ||= "admin-audit-author-search-results" %>
<% placeholder ||= t("admin.audit_actions.index.author_placeholder") %>
<% clear_label ||= t("admin.audit_actions.index.clear_author") %>
<% use_author_type = local_assigns.fetch(:use_author_type, true) %>
<% hidden_data = { audit_author_search_target: "author" }.merge(local_assigns.fetch(:hidden_data, {})) %>
<% input_data = {
  audit_author_search_target: "input",
  action: "input->audit-author-search#search focus->audit-author-search#search keydown->audit-author-search#keydown"
}.merge(local_assigns.fetch(:input_data, {})) %>

<div
  class="admin-audit-author-search position-relative"
  data-controller="audit-author-search"
  data-audit-author-search-url-value="<%= admin_audit_author_search_path %>"
  data-audit-author-search-use-author-type-value="<%= use_author_type %>">
  <%= form.hidden_field field,
    value: (admin_audit_author_value(selected_author) if selected_author),
    data: hidden_data %>
  <div class="input-group">
    <span class="input-group-text"><%= icon "search" %></span>
    <%= text_field_tag query_field,
      (admin_audit_subject_text(selected_author) if selected_author),
      class: "form-control",
      placeholder: placeholder,
      autocomplete: "off",
      role: "combobox",
      aria: {
        autocomplete: "list",
        controls: results_id,
        expanded: "false"
      },
      data: input_data %>
    <button
      type="button"
      class="btn btn-outline-secondary"
      title="<%= clear_label %>"
      aria-label="<%= clear_label %>"
      data-audit-author-search-target="clearButton"
      data-action="audit-author-search#clear"
      <%= "disabled" unless selected_author %>>
      <%= icon "x" %>
    </button>
  </div>
  <div
    id="<%= results_id %>"
    class="admin-employee-search-results admin-audit-author-search-results list-group shadow-sm"
    data-audit-author-search-target="results"
    role="listbox"
    hidden></div>
</div>
