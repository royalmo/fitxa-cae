<p style="<%= mailer_style(:paragraph) %>"><%= t(".greeting") %></p>

<p style="<%= mailer_style(:paragraph) %>"><%= t(".intro", app_name: app_name) %></p>

<dl style="<%= mailer_style(:details) %>">
  <dt style="<%= mailer_style(:details_term) %>"><%= t(".employee") %></dt>
  <dd style="<%= mailer_style(:details_description) %>"><%= @employee.full_name %></dd>

  <dt style="<%= mailer_style(:details_term) %>"><%= t(".national_id") %></dt>
  <dd style="<%= mailer_style(:details_description) %>"><%= @employee.national_id %></dd>

  <dt style="<%= mailer_style(:details_term) %>"><%= t(".email") %></dt>
  <dd style="<%= mailer_style(:details_description) %>"><%= @employee.email.presence || t(".blank") %></dd>

  <dt style="<%= mailer_style(:details_term) %>"><%= t(".phone") %></dt>
  <dd style="<%= mailer_style(:details_description) %>"><%= @employee.phone.presence || t(".blank") %></dd>

  <dt style="<%= mailer_style(:details_term) %>"><%= t(".subject_label") %></dt>
  <dd style="<%= mailer_style(:details_description) %>"><%= @subject %></dd>
</dl>

<%= simple_format(@body, style: mailer_style(:paragraph)) %>
