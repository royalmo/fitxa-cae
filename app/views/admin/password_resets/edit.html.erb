<% content_for :title, t(".title") %>

<section class="auth-card auth-card-narrow admin-auth-card">
  <header class="auth-header">
    <%= render "layouts/brand_mark", path: admin_login_path %>
    <h1><%= t(".heading") %></h1>
  </header>

  <section class="auth-panel">
    <%= render "layouts/error_summary", messages: @manager.errors.full_messages, title: t(".error_title") %>

    <%= form_with url: edit_admin_password_reset_path(params[:token]), method: :patch, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :password, t(".password") %>
        <%= form.password_field :password, autocomplete: "new-password", required: true %>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, t(".password_confirmation") %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>
      </div>

      <%= form.submit t(".submit"), data: { submitting_label: t(".submitting") } %>
    <% end %>
  </section>
</section>
