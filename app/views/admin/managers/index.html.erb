<% content_for :title, t(".title") %>
<% pagination_path = ->(page) { admin_managers_path(request.query_parameters.except("page").merge(page: page)) } %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "user-cog", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>
  <%= link_to new_admin_manager_path, class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
    <%= icon "plus" %>
    <span><%= t(".new_manager") %></span>
  <% end %>
</div>

<div data-controller="list-loading">
  <div class="mb-3">
    <%= form_with url: admin_managers_path,
      method: :get,
      class: "admin-tags-filter-form d-flex flex-column flex-lg-row align-items-stretch gap-2 w-100 mb-2",
      data: { action: "submit->list-loading#showLoading" } do |form| %>
      <%= form.label :q, t("shared.search"), class: "form-label visually-hidden" %>
      <div class="input-group flex-grow-1">
        <%= form.search_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "form-control" %>
        <%= button_tag type: :submit, class: "btn btn-outline-secondary", title: t("shared.search"), aria: { label: t("shared.search") } do %>
          <%= icon "search" %>
        <% end %>
      </div>
      <fieldset class="admin-tags-status-filter btn-group" role="group" aria-label="<%= t(".status") %>">
        <% [[t(".all_statuses"), ""], [t(".active_statuses"), "active"], [t(".disabled_statuses"), "disabled"]].each do |(label, value)| %>
          <% option_id = "manager_status_#{value.presence || "all"}" %>
          <%= form.radio_button :status,
            value,
            id: option_id,
            checked: params[:status].to_s == value,
            class: "btn-check",
            data: { action: "change->list-loading#filter" } %>
          <%= form.label :status, label, for: option_id, class: "btn btn-outline-secondary" %>
        <% end %>
      </fieldset>
    <% end %>

    <div class="text-center">
      <%= render "admin/shared/result_count",
        count: @admin_records_count,
        range_start: @admin_records_range_start,
        range_end: @admin_records_range_end %>
    </div>
  </div>

  <div data-list-loading-target="results">
    <section class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th><%= t(".name") %></th>
              <th><%= t(".email") %></th>
              <th><%= t(".last_access") %></th>
              <th class="text-end"><%= t("shared.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @managers.each do |manager| %>
              <% manager_status = admin_manager_status(manager) %>
              <% manager_name = manager_display_name(manager) %>
              <% activation_action = admin_manager_activation_action(manager) %>
              <% activation_modal_id = admin_manager_activation_modal_id(manager) %>
              <% activation_disabled = admin_manager_self_deactivation_disabled?(manager) %>
              <% activation_button_title = admin_manager_activation_button_title(manager, activation_action) %>
              <tr class="<%= class_names("admin-manager-row", "is-inactive": manager_status == :disabled) %>">
                <td>
                  <span class="admin-manager-name">
                    <%= icon admin_manager_status_icon(manager_status),
                      class: admin_manager_status_icon_class(manager_status),
                      title: status_text(manager_status) %>
                    <strong><%= manager_name %></strong>
                  </span>
                </td>
                <td><%= manager.email.presence || t(".no_email") %></td>
                <td class="text-nowrap"><%= admin_manager_last_access_text(manager) %></td>
                <td class="text-end">
                  <div class="d-inline-flex align-items-center justify-content-end gap-1">
                    <% if activation_disabled %>
                      <span
                        class="d-inline-block"
                        title="<%= activation_button_title %>"
                        tabindex="0"
                        data-controller="bootstrap-tooltip"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top">
                    <% end %>
                      <button type="button"
                        class="<%= admin_manager_activation_button_class(manager) %>"
                        title="<%= activation_button_title %>"
                        aria-label="<%= activation_button_title %>"
                        <%= "disabled" if activation_disabled %>
                        <% unless activation_disabled %>
                          data-bs-toggle="modal"
                          data-bs-target="#<%= activation_modal_id %>"
                        <% end %>>
                        <%= icon admin_manager_activation_icon(manager) %>
                      </button>
                    <% if activation_disabled %>
                      </span>
                    <% end %>

                    <%= link_to edit_admin_manager_path(manager),
                      class: "btn btn-sm btn-outline-secondary admin-row-action",
                      title: t("shared.edit"),
                      aria: { label: t("shared.edit") } do %>
                      <%= icon "pencil" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% @managers.each do |manager| %>
        <% unless admin_manager_self_deactivation_disabled?(manager) %>
          <%= render "activation_modal", manager: manager, action: admin_manager_activation_action(manager) %>
        <% end %>
      <% end %>

      <% if @managers.empty? %>
        <div class="card-body text-center text-body-secondary">
          <%= t(".empty") %>
        </div>
      <% end %>
    </section>

    <%= render "admin/shared/pagination",
      page: @admin_page,
      total_pages: @admin_total_pages,
      previous_page: @admin_previous_page,
      next_page: @admin_next_page,
      path: pagination_path %>
  </div>

  <%= render "admin/shared/list_loading" %>
</div>
