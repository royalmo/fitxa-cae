<% content_for :title, t(".title") %>
<% pagination_path = ->(page) { admin_corrections_path(request.query_parameters.except("page").merge(page: page)) } %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "square-pen", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>
  <%= link_to new_admin_correction_path, class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
    <%= icon "plus" %>
    <span><%= t(".new_correction") %></span>
  <% end %>
</div>

<div data-controller="list-loading">
  <div class="mb-3">
    <%= form_with url: admin_corrections_path,
      method: :get,
      class: "admin-corrections-filter-form d-flex flex-column gap-2 w-100 mb-2",
      data: { action: "submit->list-loading#showLoading" } do |form| %>
      <div class="admin-corrections-employee-filter">
        <%= form.label :employee_query, t(".employee"), class: "form-label visually-hidden" %>
        <div
          class="admin-employee-search position-relative"
          data-controller="employee-search"
          data-employee-search-url-value="<%= admin_employee_search_path %>">
          <%= form.hidden_field :employee_id,
            value: @selected_employee_id.to_s,
            data: { employee_search_target: "employeeId" } %>
          <div class="input-group">
            <span class="input-group-text"><%= icon "search" %></span>
            <%= text_field_tag :employee_query,
              @selected_employee ? employee_display_name(@selected_employee) : nil,
              class: "form-control",
              placeholder: t(".employee_search_placeholder"),
              autocomplete: "off",
              role: "combobox",
              aria: {
                autocomplete: "list",
                controls: "admin-corrections-employee-results",
                expanded: "false"
              },
              data: {
                employee_search_target: "input",
                action: "input->employee-search#search focus->employee-search#search keydown->employee-search#keydown"
              } %>
            <button
              type="button"
              class="btn btn-outline-secondary"
              title="<%= t(".all_employees") %>"
              aria-label="<%= t(".all_employees") %>"
              data-action="employee-search#clear">
              <%= icon "x" %>
            </button>
          </div>
          <div
            id="admin-corrections-employee-results"
            class="admin-employee-search-results list-group shadow-sm"
            data-employee-search-target="results"
            role="listbox"
            hidden></div>
        </div>
      </div>

      <div class="admin-corrections-secondary-filters d-flex flex-column flex-xl-row align-items-stretch gap-2">
        <fieldset class="admin-corrections-status-filter btn-group" role="group" aria-label="<%= t(".status") %>">
          <% [ "" ].concat(@filterable_statuses).each do |status| %>
            <% option_id = "admin_correction_status_#{status.presence || "all"}" %>
            <%= form.radio_button :status,
              status,
              id: option_id,
              checked: @selected_status.to_s == status.to_s,
              class: "btn-check",
              autocomplete: "off",
              data: { action: "change->list-loading#filter" } %>
            <%= form.label :status,
              for: option_id,
              class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" do %>
              <%= icon admin_corrections_status_filter_icon(status), class: "admin-badge-icon" %>
              <span><%= admin_corrections_status_filter_label(status) %></span>
            <% end %>
          <% end %>
        </fieldset>

        <span class="admin-corrections-period-label">
          <span aria-hidden="true">·</span>
          <span><%= t(".period_prefix") %></span>
        </span>

        <div class="admin-corrections-period">
          <%= form.label :month, t(".month"), class: "form-label visually-hidden" %>
          <%= form.label :year, t(".year"), class: "form-label visually-hidden" %>
          <div class="input-group flex-nowrap">
            <%= form.select :month,
              [[t(".all_months"), ""]] + admin_corrections_month_options,
              { selected: @selected_month || "" },
              class: "form-select",
              data: { action: "change->list-loading#filter" } %>
            <span class="input-group-text"><%= t(".period_connector") %></span>
            <%= form.select :year,
              [[t(".all_years"), ""]] + @year_options,
              { selected: @selected_year || "" },
              class: "form-select",
              data: { action: "change->list-loading#filter" } %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="text-center">
      <%= render "admin/shared/result_count",
        count: @admin_records_count,
        range_start: @admin_records_range_start,
        range_end: @admin_records_range_end %>
    </div>
  </div>

  <div data-list-loading-target="results" data-controller="correction-highlight">
    <section class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th><%= t(".employee") %></th>
              <th><%= t(".date") %></th>
              <th><%= t(".request") %></th>
              <th><%= t(".status") %></th>
              <th><%= t(".validator") %></th>
              <th><%= t(".age") %></th>
              <th class="text-end"><%= t("shared.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @corrections.each do |correction| %>
              <% highlighted = @highlight_day == correction.day %>
              <% row_options = {
                class: class_names("admin-correction-row", "is-highlighted": highlighted),
                data: { correction_day: correction.day.iso8601 }
              } %>
              <% if highlighted %>
                <% row_options[:data][:correction_highlight_target] = "row" %>
                <% row_options[:tabindex] = "-1" %>
              <% end %>
              <%= tag.tr(**row_options) do %>
                <td><strong><%= employee_display_name(correction.employee) %></strong></td>
                <td><%= l(correction.day, format: :short) %></td>
                <td>
                  <strong><%= correction_title(correction) %></strong>
                  <div class="small text-body-secondary"><%= correction_requested_text(correction) %></div>
                </td>
                <td>
                  <span class="<%= bootstrap_status_badge_class(correction.status) %>">
                    <%= icon correction_status_icon_name(correction.status), class: "admin-badge-icon" %>
                    <span><%= status_text(correction.status) %></span>
                  </span>
                </td>
                <td><%= correction.validator ? manager_display_name(correction.validator) : "—" %></td>
                <td><%= l(correction.created_at, format: :short) %></td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <%= link_to admin_correction_path(correction),
                      class: "btn btn-sm btn-outline-secondary admin-row-action",
                      title: t("shared.view"),
                      aria: { label: t("shared.view") } do %>
                      <%= icon "eye" %>
                    <% end %>
                    <%= link_to edit_admin_correction_path(correction),
                      class: "btn btn-sm btn-outline-secondary admin-row-action",
                      title: t("shared.edit"),
                      aria: { label: t("shared.edit") } do %>
                      <%= icon "pencil" %>
                    <% end %>
                    <% if correction.pending? %>
                      <%= button_to approve_admin_correction_path(correction),
                        method: :post,
                        form_class: "m-0",
                        class: "btn btn-sm btn-outline-success admin-row-action",
                        title: t("shared.approve"),
                        aria: { label: t("shared.approve") },
                        data: { submitting_label: t("shared.submitting.approving") } do %>
                        <%= icon "check" %>
                      <% end %>
                      <%= button_to reject_admin_correction_path(correction),
                        method: :post,
                        form_class: "m-0",
                        class: "btn btn-sm btn-outline-danger admin-row-action",
                        title: t("shared.reject"),
                        aria: { label: t("shared.reject") },
                        data: { submitting_label: t("shared.submitting.rejecting") } do %>
                        <%= icon "x" %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @corrections.empty? %>
        <div class="card-body text-center text-body-secondary">
          <%= t(".empty") %>
        </div>
      <% end %>
    </section>

    <%= render "admin/shared/pagination",
      page: @admin_page,
      total_pages: @admin_total_pages,
      previous_page: @admin_previous_page,
      next_page: @admin_next_page,
      path: pagination_path %>
  </div>

  <%= render "admin/shared/list_loading" %>
</div>
