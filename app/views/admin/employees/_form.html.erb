<% if employee.errors.any? %>
  <div class="alert alert-danger error-summary">
    <strong><%= t("admin.employees.form.error_title") %></strong>
    <ul class="mb-0 mt-2">
      <% employee.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% status_id_suffix = employee.persisted? ? employee.id : "new" %>
<% national_id_locked = employee.national_id_locked? %>
<% national_id_locked_tooltip = t("admin.employees.form.national_id_locked_tooltip") %>
<% welcome_email_resend_available = employee.persisted? && employee.welcome_email_resendable? %>
<% welcome_email_resend_disabled_reason =
  t("admin.employees.welcome_email.#{employee.welcome_email_resend_blocked_reason_key}") if employee.persisted? && !welcome_email_resend_available %>
<% welcome_email_resend_modal_id = "employee_welcome_email_resend_modal_#{employee.id}" if employee.persisted? %>
<% welcome_email_resend_action_classes = "d-inline-block mt-2 mt-md-0 ms-md-auto" %>
<% welcome_email_resend_button_classes = "btn btn-link d-inline-flex align-items-center gap-1 p-0 text-start" %>
<% welcome_email_resend_data = if employee.persisted?
  {
    controller: "employee-welcome-resend",
    employee_welcome_resend_url_value: resend_welcome_email_admin_employee_path(employee),
    employee_welcome_resend_request_error_label_value: t("admin.employees.welcome_email.request_error")
  }
end %>

<%= form_with model: [:admin, employee], data: welcome_email_resend_data do |form| %>
  <div class="row g-3">
    <div class="col-12 col-md-6">
      <%= form.label :first_name, t("admin.employees.form.first_name"), class: "form-label" %>
      <%= form.text_field :first_name, autocomplete: "given-name", class: "form-control" %>
    </div>
    <div class="col-12 col-md-6">
      <%= form.label :last_name, t("admin.employees.form.last_name"), class: "form-label" %>
      <%= form.text_field :last_name, autocomplete: "family-name", class: "form-control" %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :national_id, t("admin.employees.form.national_id"), class: "form-label" %>
      <% national_id_field = capture do %>
        <%= form.text_field :national_id,
          class: class_names("form-control", "pe-none": national_id_locked),
          disabled: national_id_locked,
          title: (national_id_locked ? national_id_locked_tooltip : nil) %>
      <% end %>
      <% if national_id_locked %>
        <span class="d-block"
          title="<%= national_id_locked_tooltip %>"
          tabindex="0"
          data-controller="bootstrap-tooltip"
          data-bs-toggle="tooltip"
          data-bs-placement="top">
          <%= national_id_field %>
        </span>
      <% else %>
        <%= national_id_field %>
      <% end %>
    </div>

    <fieldset class="col-12 col-md-6 admin-status-radio-fieldset">
      <legend class="form-label"><%= t("admin.employees.form.status") %></legend>
      <div class="btn-group w-100 admin-status-radio-group" role="group" aria-label="<%= t("admin.employees.form.status") %>">
        <% [[t("admin.employees.form.statuses.active"), true], [t("admin.employees.form.statuses.disabled"), false]].each do |(label, value)| %>
          <% option_id = "employee_active_#{status_id_suffix}_#{value}" %>
          <%= form.radio_button :active,
            value,
            id: option_id,
            checked: value ? employee.active? : !employee.active?,
            disabled: !employee.persisted?,
            class: "btn-check" %>
          <%= form.label :active,
            for: option_id,
            class: class_names("btn admin-status-radio-option", "is-active": value, "is-inactive": !value) do %>
            <%= icon value ? "circle-check" : "circle-off", class: "admin-status-radio-icon" %>
            <span><%= label %></span>
          <% end %>
        <% end %>
      </div>
    </fieldset>

    <div class="col-12 col-md-6">
      <%= form.label :email, t("admin.employees.form.email"), class: "form-label" %>
      <%= form.email_field :email, autocomplete: "email", class: "form-control" %>
    </div>
    <div class="col-12 col-md-6">
      <%= form.label :phone, t("admin.employees.form.phone"), class: "form-label" %>
      <%= form.telephone_field :phone, autocomplete: "tel", class: "form-control" %>
    </div>

    <fieldset class="col-12">
      <legend class="form-label"><%= t("admin.employees.form.tags") %></legend>
      <%= render "admin/shared/tag_multi_search",
        form: form,
        field: :tag_ids,
        query_field: :employee_tag_query,
        selected_tags: employee.tags,
        placeholder: t("admin.shared.tag_search.placeholder"),
        results_id: "admin-employee-tag-results" %>
    </fieldset>

    <div class="col-12">
      <div class="admin-employee-form-preferences d-md-flex align-items-md-center justify-content-md-between gap-2">
        <div class="form-check form-switch">
          <%= form.check_box :allow_corrections, class: "form-check-input", role: "switch" %>
          <%= form.label :allow_corrections, t("admin.employees.form.allow_corrections"), class: "form-check-label" %>
        </div>
        <% if employee.persisted? %>
          <% welcome_email_resend_button = capture do %>
            <%= button_tag type: :button,
              class: welcome_email_resend_button_classes,
              disabled: !welcome_email_resend_available,
              style: ("pointer-events: none;" unless welcome_email_resend_available),
              data: { action: "employee-welcome-resend#openConfirm" } do %>
              <%= icon "mail" %>
              <span><%= t("admin.employees.welcome_email.button") %></span>
            <% end %>
          <% end %>
          <% if welcome_email_resend_available %>
            <span class="<%= welcome_email_resend_action_classes %>">
              <%= welcome_email_resend_button %>
            </span>
          <% else %>
            <span class="<%= welcome_email_resend_action_classes %>"
              title="<%= welcome_email_resend_disabled_reason %>"
              tabindex="0"
              data-controller="bootstrap-tooltip"
              data-bs-toggle="tooltip"
              data-bs-placement="top">
              <%= welcome_email_resend_button %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= link_to admin_employees_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
      <%= icon "x" %>
      <span><%= t("shared.cancel") %></span>
    <% end %>
    <%= button_tag type: :submit, class: "btn btn-primary d-inline-flex align-items-center gap-2", data: { submitting_label: t("shared.submitting.saving") } do %>
      <%= icon "save" %>
      <span><%= t(employee.persisted? ? "shared.save" : "admin.employees.form.create") %></span>
    <% end %>
  </div>

  <% if employee.persisted? %>
    <div class="modal fade"
      id="<%= welcome_email_resend_modal_id %>"
      tabindex="-1"
      aria-labelledby="<%= welcome_email_resend_modal_id %>_label"
      aria-hidden="true"
      data-employee-welcome-resend-target="confirmModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="<%= welcome_email_resend_modal_id %>_label">
              <%= t("admin.employees.welcome_email.confirm_title") %>
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.cancel") %>"></button>
          </div>
          <div class="modal-body">
            <p class="mb-0">
              <%= t("admin.employees.welcome_email.confirm_body_html", email: tag.strong(employee.email.presence || "-")) %>
            </p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
              <%= t("shared.cancel") %>
            </button>
            <button type="button"
              class="btn btn-primary d-inline-flex align-items-center gap-2"
              data-action="employee-welcome-resend#send"
              data-employee-welcome-resend-target="confirmButton">
              <%= icon "send" %>
              <span><%= t("admin.employees.welcome_email.confirm") %></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%= render "admin/shared/async_progress_modal",
      modal_id: "employee_welcome_email_resend_progress_modal_#{employee.id}",
      controller_name: "employee-welcome-resend",
      target_prefix: "run",
      title: t("admin.employees.welcome_email.progress_title"),
      description: t("admin.employees.welcome_email.progress_description"),
      close_label: t("admin.employees.welcome_email.close") %>
  <% end %>

  <% if employee.persisted? && employee.multiple_employment_periods? %>
    <hr>

    <section class="admin-employment-periods">
      <h2 class="h5"><%= t("admin.employees.form.employment_periods") %></h2>
      <ul class="list-unstyled mb-0 d-flex flex-column gap-1">
        <% employee.employment_periods.chronological.each do |period| %>
          <li class="small text-body-secondary">
            <%= l(period.started_at.to_date, format: :short) %>
            -
            <%= period.ended_at ? l(period.ended_at.to_date, format: :short) : t("admin.employees.form.current_employment_period") %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
