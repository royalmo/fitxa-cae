<% form_url = manager.persisted? ? admin_manager_path(manager) : admin_managers_path %>
<% selected_employee = manager.employee %>
<% password_label = t("admin.managers.form.password") %>
<% password_label = "#{password_label} (#{t("admin.managers.form.password_keep_blank")})" if manager.persisted? %>
<% status_id_suffix = manager.persisted? ? manager.id : "new" %>

<% if manager.errors.any? %>
  <div class="alert alert-danger error-summary">
    <strong><%= t("admin.managers.form.error_title") %></strong>
    <ul class="mb-0 mt-2">
      <% manager.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: manager, url: form_url do |form| %>
  <section class="card shadow-sm">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <%= form.label :first_name, t("admin.managers.form.first_name"), class: "form-label" %>
          <%= form.text_field :first_name, autocomplete: "given-name", class: "form-control" %>
        </div>
        <div class="col-12 col-md-6">
          <%= form.label :last_name, t("admin.managers.form.last_name"), class: "form-label" %>
          <%= form.text_field :last_name, autocomplete: "family-name", class: "form-control" %>
        </div>
        <div class="col-12 col-md-6">
          <%= form.label :email, t("admin.managers.form.email"), class: "form-label" %>
          <%= form.email_field :email, autocomplete: "email", class: "form-control" %>
        </div>
        <div class="col-12 col-md-6">
          <%= form.label :password, password_label, class: "form-label" %>
          <%= form.password_field :password, autocomplete: "new-password", class: "form-control" %>
        </div>
        <div class="col-12 col-md-6">
          <%= form.label :employee_id, t("admin.managers.form.employee"), class: "form-label" %>
          <div
            class="admin-employee-search position-relative"
            data-controller="employee-search"
            data-employee-search-url-value="<%= admin_employee_search_path %>"
            data-employee-search-auto-submit-value="false">
            <%= form.hidden_field :employee_id,
              value: manager.employee_id.to_s,
              data: { employee_search_target: "employeeId" } %>
            <div class="input-group">
              <span class="input-group-text"><%= icon "search" %></span>
              <%= text_field_tag :manager_employee_query,
                selected_employee ? employee_display_name(selected_employee) : nil,
                class: "form-control",
                placeholder: t("admin.managers.form.employee_search_placeholder"),
                autocomplete: "off",
                role: "combobox",
                aria: {
                  autocomplete: "list",
                  controls: "admin-manager-employee-results",
                  expanded: "false"
                },
                data: {
                  employee_search_target: "input",
                  action: "input->employee-search#search focus->employee-search#search keydown->employee-search#keydown"
                } %>
              <button
                type="button"
                class="btn btn-outline-secondary"
                title="<%= t("admin.managers.form.no_employee") %>"
                aria-label="<%= t("admin.managers.form.no_employee") %>"
                data-action="employee-search#clear">
                <%= icon "x" %>
              </button>
            </div>
            <div
              id="admin-manager-employee-results"
              class="admin-employee-search-results list-group shadow-sm"
              data-employee-search-target="results"
              role="listbox"
              hidden></div>
          </div>
        </div>
        <fieldset class="col-12 col-md-6 admin-status-radio-fieldset">
          <legend class="form-label"><%= t("admin.managers.form.status") %></legend>
          <div class="btn-group w-100 admin-status-radio-group" role="group" aria-label="<%= t("admin.managers.form.status") %>">
            <% [[status_text(:active), true], [status_text(:disabled), false]].each do |(label, value)| %>
              <% option_id = "manager_active_#{status_id_suffix}_#{value}" %>
              <%= form.radio_button :active,
                value,
                id: option_id,
                checked: value ? manager.active? : !manager.active?,
                class: "btn-check" %>
              <%= form.label :active,
                for: option_id,
                class: class_names("btn admin-status-radio-option", "is-active": value, "is-inactive": !value) do %>
                <%= icon value ? "circle-check" : "circle-off", class: "admin-status-radio-icon" %>
                <span><%= label %></span>
              <% end %>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>
  </section>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= link_to admin_managers_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
      <%= icon "x" %>
      <span><%= t("shared.cancel") %></span>
    <% end %>
    <%= button_tag type: :submit, class: "btn btn-primary d-inline-flex align-items-center gap-2", data: { submitting_label: t("shared.submitting.saving") } do %>
      <%= icon "save" %>
      <span><%= t("shared.save") %></span>
    <% end %>
  </div>
<% end %>
