<header class="report-header report-summary-header">
  <%= pdf_brand_logo %>
  <h1 class="report-summary-title">
    Resum mensual - <%= pdf_month_year_title(@report.fetch(:period_start)) %>
  </h1>
</header>

<section class="report-section">
  <p class="report-muted">
    Recompte d'hores per cada persona activa o amb fitxatges en aquest mes.
    S'apliquen correccions aprovades, i s'ignoren fitxatges incorrectes o correccions pendents.
  </p>
  <table>
    <thead>
      <tr>
        <th>Persona</th>
        <th>DNI/NIE</th>
        <th>Etiquetes</th>
        <th class="report-text-end">Fitxatges</th>
        <th class="report-text-end">Hores</th>
      </tr>
    </thead>
    <tbody>
      <% @report.fetch(:rows).each do |row| %>
        <% employee = row.fetch(:employee) %>
        <tr>
          <td>
            <%= employee_display_name(employee) %>
            <% unless row.fetch(:active) %>
              <span class="report-muted">(inactiva)</span>
            <% end %>
          </td>
          <td><em class="report-muted"><%= employee.national_id %></em></td>
          <td>
            <% if row.fetch(:tags).any? %>
              <div class="report-tags">
                <% row.fetch(:tags).each do |tag| %>
                  <span class="report-tag"><%= tag.name %></span>
                <% end %>
              </div>
            <% else %>
              <span class="report-muted">---</span>
            <% end %>
          </td>
          <td class="report-text-end"><%= row.fetch(:swipes_count) %></td>
          <td class="report-text-end report-nowrap">
            <span class="<%= "report-duration-zero" if row.fetch(:worked_seconds).zero? %>">
              <%= duration_text(row.fetch(:worked_seconds)) %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
