#!/usr/bin/env ruby

env_path = File.expand_path("../.env", __dir__)

if File.file?(env_path)
  File.foreach(env_path) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    line = line.delete_prefix("export ").strip
    key, value = line.split("=", 2)
    next if value.nil? || key !~ /\A[A-Za-z_][A-Za-z0-9_]*\z/

    value = value.strip
    if value.length >= 2 && value.start_with?("\"") && value.end_with?("\"")
      value = value[1...-1].gsub("\\n", "\n")
    elsif value.length >= 2 && value.start_with?("'") && value.end_with?("'")
      value = value[1...-1]
    end

    ENV[key] = value
  end
end

system "./bin/rails", "dartsass:build", exception: true
exec "./bin/rails", "server", *ARGV
