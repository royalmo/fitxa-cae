<% content_for :title, t(".title") %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2 min-w-0">
    <%= icon "toggle-left", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>

  <%= link_to admin_employees_path, class: "btn btn-outline-secondary border-0 d-inline-flex align-items-center gap-2" do %>
    <%= icon "arrow-left" %>
    <span><%= t("admin.employee_bulk_actions.back") %></span>
  <% end %>
</div>

<%= render "national_ids_bulk_form",
  run_path: run_bulk_activation_admin_employees_path,
  simulate_path: simulate_bulk_activation_admin_employees_path,
  action_options: [
    { value: "activate", label: t(".actions.activate"), icon: "circle-check", class: "is-active" },
    { value: "deactivate", label: t(".actions.deactivate"), icon: "circle-off", class: "is-inactive" }
  ],
  confirm_modal_id: "adminEmployeeBulkActivationConfirmModal",
  submit_label: t(".run") %>
