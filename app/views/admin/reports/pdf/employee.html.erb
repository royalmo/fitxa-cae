<% employee = @report.fetch(:employee) %>
<% totals = @report.fetch(:totals) %>

<% content_for :report_footer_legend do %>
  <span class="report-footer-legend-item"><%= icon "log-in", class: "report-footer-icon" %> Entrada</span>
  <span class="report-footer-legend-item"><%= icon "log-out", class: "report-footer-icon" %> Sortida</span>
  <span class="report-footer-legend-item"><%= icon "asterisk", class: "report-footer-icon" %> Corregida</span>
  <span class="report-footer-legend-item"><span class="report-footer-deleted-example">08:00</span> Eliminada</span>
<% end %>

<header class="report-header report-summary-header">
  <%= pdf_brand_logo %>
  <div class="report-employee-period">Fitxatges - <%= pdf_month_year_title(@report.fetch(:period_start)) %></div>
</header>

<section class="report-section">
  <h1><%= employee_display_name(employee) %></h1>
  <div class="report-muted report-employee-metadata">
    <div class="report-employee-contact">
      <em><%= employee.national_id %></em>
      <% if employee.email.present? %> · <%= employee.email %><% end %>
      <% if employee.phone.present? %> · <%= employee.phone %><% end %>
    </div>
    <% if @report.fetch(:tags).any? %>
      <div class="report-tags report-employee-tags">
        <% @report.fetch(:tags).each do |tag| %>
          <span class="report-tag"><%= tag.name %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section class="report-section">
  <div class="report-kpis">
    <div class="report-kpi">
      <div class="report-kpi-label">Hores treballades</div>
      <div class="report-kpi-value"><%= duration_text(totals.fetch(:worked_seconds)) %></div>
    </div>
    <div class="report-kpi">
      <div class="report-kpi-label">Dies amb fitxatges</div>
      <div class="report-kpi-value"><%= totals.fetch(:worked_days) %></div>
    </div>
    <div class="report-kpi">
      <div class="report-kpi-label">Fitxatges</div>
      <div class="report-kpi-value"><%= totals.fetch(:swipes_count) %></div>
    </div>
    <div class="report-kpi">
      <div class="report-kpi-label">Correccions</div>
      <div class="report-kpi-value"><%= totals.fetch(:corrections_count) %></div>
    </div>
  </div>
</section>

<section class="report-section">
  <table>
    <thead>
      <tr>
        <th>Dia</th>
        <th>Fitxatges</th>
        <th class="report-text-end">Hores</th>
      </tr>
    </thead>
    <tbody>
      <% @report.fetch(:days).each do |day| %>
        <tr class="<%= "report-empty-day" unless day.fetch(:swipes).any? %>">
          <td class="report-nowrap"><%= l(day.fetch(:date), format: :weekday_day_month) %></td>
          <td>
            <% if day.fetch(:swipes).any? %>
              <% day.fetch(:swipes).each do |swipe| %>
                <span class="report-swipe report-swipe-<%= swipe.fetch(:kind) %> <%= "report-swipe-deleted" if swipe.fetch(:invalidated) %>">
                  <%= icon clocking_icon_name(swipe.fetch(:kind)), class: "report-swipe-icon" %>
                  <span class="<%= class_names("report-swipe-time", "report-swipe-deleted-time": swipe.fetch(:invalidated)) %>">
                    <%= l(swipe.fetch(:swipe_at), format: :hour_minute) %>
                    <% if swipe.fetch(:forged) %>
                      <%= icon "asterisk", class: "report-correction-icon report-swipe-corrected" %>
                    <% end %>
                  </span>
                </span>
              <% end %>
            <% else %>
              <span class="report-muted">---</span>
            <% end %>
          </td>
          <td class="report-text-end report-nowrap"><%= duration_text(day.fetch(:worked_seconds)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
