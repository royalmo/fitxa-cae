<% content_for :title, t(".title") %>
<% pagination_path = ->(page) { admin_audit_actions_path(request.query_parameters.except("page").merge(page: page)) } %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "activity", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>
  <button
    type="button"
    class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
    data-bs-toggle="modal"
    data-bs-target="#admin_audit_actions_export_modal">
    <%= icon "download" %>
    <span><%= t(".export") %></span>
  </button>
</div>

<%= render "export_modal", total_count: @admin_records_count %>

<div data-controller="list-loading">
  <div class="mb-3">
    <%= form_with url: admin_audit_actions_path,
      method: :get,
      class: "admin-audit-actions-filter-form d-flex flex-column gap-2 w-100 mb-2",
      data: {
        controller: "audit-filters",
        action: "submit->list-loading#showLoading"
      } do |form| %>
      <div class="admin-audit-actions-primary-filters d-flex flex-column flex-xl-row align-items-stretch gap-2">
        <fieldset class="admin-audit-actions-author-kind-filter btn-group" role="group" aria-label="<%= t(".author_kind") %>">
          <% [["", "all"], ["Employee", "employees"], ["Manager", "managers"]].each do |author_type, key| %>
            <% option_id = "audit_author_type_#{key}" %>
            <%= form.radio_button :author_type,
              author_type,
              id: option_id,
              checked: @selected_author_type.to_s == author_type,
              class: "btn-check",
              autocomplete: "off",
              data: { action: "change->audit-filters#clearAuthor change->list-loading#filter" } %>
            <%= form.label :author_type, for: option_id, class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" do %>
              <%= icon admin_audit_author_kind_filter_icon(author_type), class: "admin-badge-icon" %>
              <span><%= admin_audit_author_kind_filter_label(author_type) %></span>
            <% end %>
          <% end %>
        </fieldset>

        <div class="admin-audit-actions-kind-filter flex-grow-1">
          <%= form.label :kind, t(".kind"), class: "form-label visually-hidden" %>
          <%= render "admin/shared/audit_kind_search",
            form: form,
            selected_kind: @selected_kind,
            results_id: "admin-audit-actions-kind-results" %>
        </div>

        <div class="admin-audit-actions-period-filter">
          <%= form.label :month, t(".month"), class: "form-label visually-hidden" %>
          <%= form.label :year, t(".year"), class: "form-label visually-hidden" %>
          <div class="input-group flex-nowrap">
            <%= form.select :month,
              [[t(".all_months"), ""]] + admin_audit_actions_month_options,
              { selected: @selected_month || "" },
              class: "form-select",
              data: { action: "change->list-loading#filter" } %>
            <span class="input-group-text"><%= t(".period_connector") %></span>
            <%= form.select :year,
              [[t(".all_years"), ""]] + @year_options.map { |year| [year, year] },
              { selected: @selected_year || "" },
              class: "form-select",
              data: { action: "change->list-loading#filter" } %>
          </div>
        </div>
      </div>

      <div class="admin-audit-actions-subject-filters d-flex flex-column flex-xl-row align-items-stretch gap-2">
        <div class="admin-audit-actions-subject-filter">
          <%= form.label :author, t(".author_filter"), class: "form-label mb-0 admin-audit-actions-subject-label" %>
          <div class="admin-audit-actions-subject-search">
            <%= render "admin/shared/audit_author_search",
              form: form,
              selected_author: @selected_author,
              hidden_data: { audit_filters_target: "author" },
              input_data: { audit_filters_target: "authorInput" },
              results_id: "admin-audit-actions-author-results" %>
          </div>
        </div>

        <div class="admin-audit-actions-subject-filter">
          <%= form.label :recipient, t(".recipient_filter"), class: "form-label mb-0 admin-audit-actions-subject-label" %>
          <div class="admin-audit-actions-subject-search">
            <%= render "admin/shared/audit_author_search",
              form: form,
              field: :recipient,
              query_field: :recipient_query,
              selected_author: @selected_recipient,
              clear_label: t(".clear_recipient"),
              results_id: "admin-audit-actions-recipient-results",
              use_author_type: false %>
          </div>
        </div>
      </div>
    <% end %>

    <hr class="admin-filters-divider">

    <div class="text-center">
      <%= render "admin/shared/result_count",
        count: @admin_records_count,
        range_start: @admin_records_range_start,
        range_end: @admin_records_range_end %>
    </div>
  </div>

  <div data-list-loading-target="results">
    <section class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th><%= t(".created_at") %></th>
              <th><%= t(".author") %></th>
              <th><%= t(".activity") %></th>
              <th class="text-end"><%= t("shared.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @audit_actions.each do |audit_action| %>
              <% author = audit_action.author %>
              <% author_path = admin_audit_subject_path(author) %>
              <tr>
                <td class="text-nowrap"><%= l(audit_action.created_at, format: :short) %></td>
                <td class="admin-audit-author-cell">
                  <% if author_path %>
                    <%= link_to author_path,
                      class: "admin-audit-subject-link",
                      title: admin_audit_subject_text(author) do %>
                      <% if author.is_a?(Manager) %>
                        <%= icon "user-cog", class: "admin-audit-author-icon" %>
                      <% end %>
                      <span class="admin-audit-subject-name"><%= admin_audit_subject_text(author) %></span>
                    <% end %>
                  <% else %>
                    <span class="admin-audit-subject-name"><%= admin_audit_subject_text(author) %></span>
                  <% end %>
                </td>
                <td><%= admin_audit_action_detail_text(audit_action) %></td>
                <td class="text-end">
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary admin-row-action"
                    title="<%= t(".view_action") %>"
                    aria-label="<%= t(".view_action") %>"
                    data-bs-toggle="modal"
                    data-bs-target="#<%= admin_audit_action_modal_id(audit_action) %>">
                    <%= icon "eye" %>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% @audit_actions.each do |audit_action| %>
        <%= render "detail_modal", audit_action: audit_action %>
      <% end %>

      <% if @audit_actions.empty? %>
        <div class="card-body text-center text-body-secondary">
          <%= t(".empty") %>
        </div>
      <% end %>
    </section>

    <%= render "admin/shared/pagination",
      page: @admin_page,
      total_pages: @admin_total_pages,
      previous_page: @admin_previous_page,
      next_page: @admin_next_page,
      path: pagination_path %>
  </div>

  <%= render "admin/shared/list_loading" %>
</div>
