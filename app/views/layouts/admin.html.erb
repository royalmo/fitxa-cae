<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-pwa="admin" data-theme-preference="light" data-theme="light">
  <head>
    <%= render "layouts/head", admin: true, manifest: false, theme_color: "#f8f9fa", stylesheets: %w[fonts admin_bootstrap admin] %>
    <%= javascript_include_tag "popper", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "bootstrap", "data-turbo-track": "reload" %>
  </head>

  <body class="admin-shell bg-body-tertiary min-vh-100" data-controller="admin-theme submit-feedback">
    <% manager_name = manager_display_name(@manager) %>
    <% manager_first_name = @manager&.first_name.presence || manager_name %>
    <% account_active = request.path.start_with?(admin_account_path) %>
    <% nav_items = [
      [admin_root_path, "house", t("admin.nav.home"), true],
      [admin_employees_path, "users", t("admin.nav.employees"), false],
      [admin_swipes_path, "clock", t("admin.nav.swipes"), false],
      [admin_corrections_path, "square-pen", t("admin.nav.corrections"), false],
      [admin_reports_path, "chart-column", t("admin.nav.reports"), false],
      [admin_calendars_path, "calendar-days", t("admin.nav.calendars"), false],
      [admin_classifications_path, "tags", t("admin.nav.classifications"), false],
      [admin_audit_actions_path, "activity", t("admin.nav.audit_actions"), false],
      [admin_managers_path, "user-cog", t("admin.nav.managers"), false]
    ] %>

    <nav class="navbar navbar-expand-lg bg-body border-bottom sticky-top shadow-sm">
      <div class="container-fluid">
        <button class="navbar-toggler d-lg-none me-2"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#adminSidebar"
          aria-controls="adminSidebar"
          aria-label="<%= t("admin.nav.open_menu") %>">
          <span class="navbar-toggler-icon"></span>
        </button>

        <%= render "layouts/brand_mark", path: admin_root_path, class: "navbar-brand admin-brand mb-0", badge: t("admin.nav.admin_badge") %>

        <div class="admin-topbar-actions ms-auto d-flex align-items-center gap-2">
          <%= link_to admin_corrections_path(status: "pending"),
            class: "btn admin-topbar-button admin-topbar-icon-button admin-topbar-corrections-button d-inline-flex align-items-center justify-content-center",
            title: t("admin.topbar.pending_corrections", count: @admin_pending_corrections_count),
            aria: { label: t("admin.topbar.pending_corrections", count: @admin_pending_corrections_count) } do %>
            <%= icon "square-pen" %>
            <span class="<%= class_names("admin-topbar-count-badge badge rounded-pill", @admin_pending_corrections_count.positive? ? "text-bg-primary" : "text-bg-secondary") %>">
              <%= @admin_pending_corrections_badge %>
            </span>
          <% end %>

          <% if @admin_employee_shortcut %>
            <%= link_to root_path,
              class: class_names("btn admin-topbar-button admin-topbar-icon-button admin-topbar-employee-button d-inline-flex align-items-center justify-content-center", "is-working": @admin_employee_shortcut_working),
              title: t("admin.topbar.employee_side"),
              aria: { label: t("admin.topbar.employee_side") } do %>
              <%= icon "clock" %>
              <% if @admin_employee_shortcut_working %>
                <span class="admin-topbar-working-dot" aria-hidden="true"></span>
              <% end %>
            <% end %>
          <% end %>

          <%= link_to admin_account_path,
            class: "btn admin-topbar-button d-inline-flex align-items-center gap-2",
            title: t("admin.topbar.account"),
            aria: { label: t("admin.topbar.account") } do %>
            <%= icon "circle-user" %>
            <span class="d-none d-sm-inline"><%= manager_name %></span>
          <% end %>

          <%= button_to admin_logout_path,
            method: :delete,
            form_class: "m-0",
            class: "btn admin-topbar-button admin-topbar-icon-button d-inline-flex align-items-center justify-content-center",
            title: t("admin.nav.logout"),
            aria: { label: t("admin.nav.logout") } do %>
            <%= icon "log-out" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row flex-nowrap">
        <div class="col-auto px-0">
          <aside class="admin-sidebar offcanvas-lg offcanvas-start bg-body-tertiary border-end"
            tabindex="-1"
            id="adminSidebar"
            aria-labelledby="adminSidebarLabel">
            <div class="offcanvas-header border-bottom">
              <h2 class="offcanvas-title h5" id="adminSidebarLabel"><%= t("admin.nav.label") %></h2>
              <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="<%= t("admin.nav.close_menu") %>"></button>
            </div>

            <div class="offcanvas-body d-flex flex-column p-0">
              <nav class="p-3" aria-label="<%= t("admin.nav.label") %>">
                <ul class="nav nav-pills flex-column mb-auto gap-1">
                  <% nav_items.each do |path, icon_name, label, exact| %>
                    <% target = path.to_s %>
                    <% active = exact ? request.path == target : request.path == target || request.path.start_with?("#{target}/") %>
                    <% link_classes = class_names("nav-link admin-sidebar-link d-flex align-items-center gap-2 px-2 py-2", active ? "active" : "link-body-emphasis") %>
                    <% link_options = { class: link_classes } %>
                    <% link_options[:aria] = { current: "page" } if active %>
                    <li class="nav-item">
                      <%= link_to path, **link_options do %>
                        <%= icon icon_name %>
                        <span><%= label %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </nav>

              <div class="admin-sidebar-footer mt-auto border-top p-3">
                <% account_link_options = {
                  class: class_names("nav-link admin-sidebar-link d-flex align-items-center gap-2 px-2 py-2", account_active ? "active" : "link-body-emphasis")
                } %>
                <% account_link_options[:aria] = { current: "page" } if account_active %>
                <%= link_to admin_account_path,
                  **account_link_options do %>
                  <%= icon "circle-user" %>
                  <span><%= manager_first_name %></span>
                <% end %>

                <%= button_to admin_logout_path,
                  method: :delete,
                  form_class: "m-0",
                  class: "nav-link admin-sidebar-link link-body-emphasis d-flex align-items-center gap-2 px-2 py-2 w-100" do %>
                  <%= icon "log-out" %>
                  <span><%= t("admin.nav.logout") %></span>
                <% end %>
              </div>
            </div>
          </aside>
        </div>

        <div class="col min-vh-100 px-0">
          <main class="container-xl py-4">
            <% flash.each do |type, message| %>
              <% alert_class = type.to_s == "alert" ? "alert-danger" : "alert-success" %>
              <div class="alert <%= alert_class %> alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t("shared.dismiss_flash") %>"></button>
              </div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    </div>
  </body>
</html>
