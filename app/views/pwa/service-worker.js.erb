const VERSION = <%= raw "#{app_slug}-v9".to_json %>
const SHELL_CACHE = `${VERSION}-shell`
const ASSET_CACHE = `${VERSION}-assets`

const APP_SHELL = [
  <%= raw unavailable_path.to_json %>,
  <%= raw asset_path("fonts.css").to_json %>,
  <%= raw asset_path("application.css").to_json %>,
  <%= raw asset_path("brand.css").to_json %>,
  <%= raw asset_path("application.js").to_json %>,
  <%= raw asset_path("turbo.min.js").to_json %>,
  <%= raw asset_path("stimulus.min.js").to_json %>,
  <%= raw asset_path("stimulus-loading.js").to_json %>,
  <%= raw asset_path("controllers/application.js").to_json %>,
  <%= raw asset_path("controllers/index.js").to_json %>,
  <% if app_brand_suffix_image_path.present? %>
  <%= raw app_brand_suffix_image_path.to_json %>,
  <% end %>
  "/fonts/LiberGrotesqueFamily-Regular.woff2",
  "/fonts/LiberGrotesqueFamily-News.woff2",
  "/fonts/LiberGrotesqueFamily-SemiBold.woff2",
  "/fonts/LiberGrotesqueFamily-Bold.woff2",
  "/fonts/LiberGrotesqueFamily-ExtBd.woff2",
  <%= raw app_favicon_path.to_json %>,
  <%= raw app_icon_svg_path.to_json %>,
  <%= raw app_icon_192_png_path.to_json %>,
  <%= raw app_icon_png_path.to_json %>
]

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(SHELL_CACHE)
      .then((cache) => cache.addAll(APP_SHELL))
      .then(() => self.skipWaiting())
  )
})

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys()
      .then((keys) => Promise.all(
        keys
          .filter((key) => ![SHELL_CACHE, ASSET_CACHE].includes(key))
          .map((key) => caches.delete(key))
      ))
      .then(() => self.clients.claim())
  )
})

self.addEventListener("fetch", (event) => {
  const request = event.request
  const url = new URL(request.url)

  if (url.origin !== location.origin || request.method !== "GET") return
  if (url.pathname.startsWith("/admin")) return

  if (request.mode === "navigate") {
    event.respondWith(networkFirstPage(request))
    return
  }

  if (url.pathname.startsWith("/assets/") || url.pathname.startsWith("/fonts/") || url.pathname.startsWith("/icon.") || url.pathname === "/icon-192.png" || url.pathname === "/favicon.ico") {
    event.respondWith(cacheFirst(request))
  }
})

async function networkFirstPage(request) {
  try {
    return await fetch(request)
  } catch (_error) {
    return await caches.match(<%= raw unavailable_path.to_json %>)
  }
}

async function cacheFirst(request) {
  const cached = await caches.match(request)
  if (cached) return cached

  const response = await fetch(request)
  const cache = await caches.open(ASSET_CACHE)
  cache.put(request, response.clone())
  return response
}
