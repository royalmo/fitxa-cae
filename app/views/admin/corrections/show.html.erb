<% content_for :title, t(".title") %>
<% status_label = admin_correction_status_text(@correction.status) %>
<% answered_at = correction_answered_at(@correction) %>
<% change_sets = admin_correction_change_sets(@correction, @day_swipes) %>

<%= tag.div(data: (@correction.pending? ? { controller: "correction-review-comments" } : nil)) do %>
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "square-pen", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>

  <%= link_to admin_corrections_path, class: "btn btn-outline-secondary border-0 d-inline-flex align-items-center gap-2" do %>
    <%= icon "x" %>
    <span><%= t("shared.back") %></span>
  <% end %>
</div>

<section class="<%= class_names("admin-correction-status-banner", "is-#{@correction.status}") %>">
  <div class="admin-correction-status-banner-main">
    <%= icon correction_status_icon_name(@correction.status),
      title: status_label,
      class: "admin-correction-status-banner-icon" %>
    <div class="admin-correction-status-banner-copy">
      <strong><%= status_label %></strong>
      <small>
        <% if @correction.pending? %>
          <%= t(".requested_ago", distance: admin_correction_created_ago_text(@correction)) %>
        <% elsif answered_at %>
          <%= admin_correction_relative_time_text(answered_at, capitalize: true) %>
        <% else %>
          <%= admin_correction_created_ago_text(@correction, capitalize: true) %>
        <% end %>
      </small>
    </div>
  </div>

  <div class="admin-correction-status-banner-actions">
    <% if @correction.pending? %>
      <% [ :approve, :reject ].each do |review_action| %>
        <button type="button"
          class="<%= class_names("btn btn-sm d-inline-flex align-items-center gap-2", review_action == :approve ? "btn-outline-success" : "btn-outline-danger") %>"
          data-action="correction-review-comments#copyToModal"
          data-bs-toggle="modal"
          data-bs-target="#<%= admin_correction_review_modal_id(@correction, review_action) %>">
          <%= icon(review_action == :approve ? "check" : "x") %>
          <span><%= t("shared.#{review_action}") %></span>
        </button>
      <% end %>

      <%= link_to edit_admin_correction_path(@correction),
        class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
        <%= icon "pencil" %>
        <span><%= t("shared.edit") %></span>
      <% end %>
    <% else %>
      <%= link_to new_admin_correction_path(employee_id: @correction.employee_id, day: @correction.day.iso8601),
        class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
        <%= icon "plus" %>
        <span><%= t("admin.corrections.index.new_correction") %></span>
      <% end %>
    <% end %>
  </div>
</section>

<section class="card shadow-sm mt-4">
  <div class="card-body">
    <div class="admin-correction-show-summary">
      <div class="admin-correction-show-summary-title">
        <span><%= l(@correction.day, format: :long) %></span>
        <span class="admin-correction-show-summary-separator">-</span>
        <span><%= employee_display_name(@correction.employee) %></span>
        <% if @correction.employee.national_id.present? %>
          <span class="admin-correction-show-summary-dni">
            <span aria-hidden="true">-</span>
            <em><%= @correction.employee.national_id %></em>
          </span>
        <% end %>
      </div>

      <div class="admin-correction-show-meta">
        <p>
          <%= t(".created_by",
            name: admin_correction_actor_name(@correction.requester),
            distance: admin_correction_created_ago_text(@correction)) %>
        </p>
        <% unless @correction.pending? %>
          <p>
            <%= t(".reviewed_by.#{@correction.status}",
              name: admin_correction_actor_name(@correction.validator),
              distance: admin_correction_relative_time_text(answered_at || @correction.updated_at)) %>
          </p>
        <% end %>
      </div>
    </div>

    <hr>

    <div class="admin-correction-show-section">
      <h2 class="h5"><%= t(".changes") %></h2>
      <% if change_sets.values.any?(&:any?) %>
        <div class="admin-correction-comparison" aria-label="<%= t(".before") %>: <%= admin_correction_change_set_aria_label(change_sets[:before]) %>. <%= t(".after") %>: <%= admin_correction_change_set_aria_label(change_sets[:after]) %>">
          <% [ [ :before, t(".before") ], [ :after, t(".after") ] ].each do |key, label| %>
            <% items = change_sets.fetch(key) %>
            <div class="<%= class_names("admin-correction-comparison-row", "is-#{key}") %>">
              <span class="admin-correction-comparison-label"><%= label %>:</span>
              <% if items.any? %>
                <div class="admin-correction-change-summary admin-correction-show-change-summary" aria-label="<%= admin_correction_change_set_aria_label(items) %>">
                  <% items.each do |item| %>
                    <span class="<%= class_names("admin-correction-change-item", "is-#{item[:type]}", item[:kind].present? && "is-#{item[:kind]}") %>">
                      <%= icon clocking_icon_name(item[:kind]),
                        title: clocking_kind_text(item[:kind]),
                        class: "admin-correction-change-icon" %>
                      <span><%= item[:time] %></span>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <span class="admin-correction-comparison-empty"><%= t(".no_swipes") %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <span class="text-body-secondary"><%= t(".no_changes") %></span>
      <% end %>
    </div>

    <hr>

    <div class="admin-correction-show-section">
      <h2 class="h5"><%= t(".comments") %></h2>
      <div class="d-flex flex-column gap-3">
        <div>
          <%= label_tag "admin_correction_requester_comments",
            t(".requester_comment"),
            class: "form-label" %>
          <%= text_area_tag "admin_correction_requester_comments",
            @correction.requester_comments.presence || t(".no_comments"),
            rows: 3,
            class: "form-control admin-correction-readonly-comment",
            disabled: true %>
        </div>
        <div>
          <%= label_tag "admin_correction_validator_comments",
            t(".validator_comment"),
            class: "form-label" %>
          <%= text_area_tag "admin_correction_validator_comments",
            @correction.pending? ? @correction.validator_comments.to_s : @correction.validator_comments.presence || t(".no_comments"),
            rows: 3,
            class: class_names("form-control", "admin-correction-readonly-comment": !@correction.pending?),
            disabled: !@correction.pending?,
            data: (@correction.pending? ? { correction_review_comments_target: "source" } : {}) %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if @correction.pending? %>
  <%= render "review_modal", correction: @correction, action: :approve, day_swipes: @day_swipes %>
  <%= render "review_modal", correction: @correction, action: :reject, day_swipes: @day_swipes %>
<% end %>
<% end %>
