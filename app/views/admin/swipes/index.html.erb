<% content_for :title, t(".title") %>
<% pagination_path = ->(page) { admin_swipes_path(request.query_parameters.except("page").merge(page: page)) } %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "clock", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>
  <%= link_to admin_reports_path(
    {
      month: @month.month,
      year: @month.year,
      report_scope: (@selected_employee ? "person" : nil),
      employee_id: @selected_employee&.id
    }.compact
  ), class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
    <%= icon "download" %>
    <span><%= t(".export") %></span>
  <% end %>
</div>

<div data-controller="list-loading">
  <%= form_with url: admin_swipes_path,
    method: :get,
    class: "admin-swipes-controls d-flex flex-column flex-lg-row align-items-stretch gap-2 mb-4",
    data: { controller: "swipe-search-mode", action: "submit->list-loading#showLoading" } do |form| %>
    <fieldset class="admin-swipes-search-mode">
      <legend class="visually-hidden"><%= t(".search_by") %></legend>
      <span class="admin-swipes-search-mode-label small text-body-secondary" aria-hidden="true"><%= t(".search_by") %></span>
      <div class="btn-group" role="group" aria-label="<%= t(".search_by") %>">
        <% [["person", t(".search_modes.person")], ["category", t(".search_modes.category")]].each do |mode, label| %>
          <% search_mode_id = "admin_swipes_search_mode_#{mode}" %>
          <%= form.radio_button :search_mode,
            mode,
            id: search_mode_id,
            checked: @search_mode == mode,
            class: "btn-check",
            autocomplete: "off",
            data: {
              swipe_search_mode_target: "modeInput",
              action: "change->swipe-search-mode#modeChanged"
            } %>
          <%= form.label :search_mode, label, for: search_mode_id, class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    </fieldset>

    <div class="admin-calendar-search flex-grow-1" data-swipe-search-mode-target="personPanel" <%= "hidden" if @search_mode != "person" %>>
      <%= form.label :employee_query, t(".employee"), class: "form-label visually-hidden" %>
      <div
        class="admin-employee-search position-relative"
        data-controller="employee-search"
        data-employee-search-url-value="<%= admin_employee_search_path %>">
        <%= form.hidden_field :employee_id,
          value: (@selected_employee&.id).to_s,
          data: { employee_search_target: "employeeId" } %>
        <div class="input-group">
          <span class="input-group-text"><%= icon "search" %></span>
          <%= text_field_tag :employee_query,
            @selected_employee ? employee_display_name(@selected_employee) : nil,
            class: "form-control",
            placeholder: t(".employee_search_placeholder"),
            autocomplete: "off",
            role: "combobox",
            aria: {
              autocomplete: "list",
              controls: "admin-swipes-employee-results",
              expanded: "false"
            },
            data: {
              employee_search_target: "input",
              action: "input->employee-search#search focus->employee-search#search keydown->employee-search#keydown"
            } %>
        </div>
        <div
          id="admin-swipes-employee-results"
          class="admin-employee-search-results list-group shadow-sm"
          data-employee-search-target="results"
          role="listbox"
        hidden></div>
      </div>
    </div>

    <div class="admin-swipes-category flex-grow-1" data-swipe-search-mode-target="categoryPanel" <%= "hidden" if @search_mode != "category" %>>
      <%= form.label :category, t(".category"), class: "form-label visually-hidden" %>
      <%= form.select :category,
        admin_swipes_category_options,
        { include_blank: t(".category_placeholder"), selected: @selected_category },
        class: "form-select",
        data: {
          swipe_search_mode_target: "categorySelect",
          action: "change->swipe-search-mode#categoryChanged"
        } %>
    </div>

    <div class="admin-swipes-period">
      <%= form.label :month, t(".month"), class: "form-label visually-hidden" %>
      <%= form.label :year, t(".year"), class: "form-label visually-hidden" %>
      <div class="input-group flex-nowrap">
        <%= form.select :month,
          admin_swipes_month_options,
          { selected: @month.month },
          class: "form-select",
          data: { action: "change->list-loading#filter" } %>
        <span class="input-group-text"><%= t(".period_connector") %></span>
        <%= form.select :year,
          @year_options,
          { selected: @month.year },
          class: "form-select",
          data: { action: "change->list-loading#filter" } %>
      </div>
    </div>
  <% end %>

  <% if @search_mode == "category" && @selected_category %>
    <div class="text-center mb-3">
      <%= render "admin/shared/result_count",
        count: @admin_records_count,
        range_start: @admin_records_range_start,
        range_end: @admin_records_range_end %>
    </div>
  <% end %>

  <div data-list-loading-target="results">
    <% if @search_mode == "person" && @selected_employee %>
      <section class="card shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th><%= t(".date") %></th>
                <th><%= t(".hours") %></th>
                <th><%= t(".swipes") %></th>
                <th class="text-end"><%= t("shared.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% @clocking_days.each do |day| %>
                <tr>
                  <td class="text-nowrap"><%= l(day[:date], format: :weekday_day_month) %></td>
                  <td class="<%= admin_swipes_hours_cell_class(day) %>"><%= duration_text(day[:worked_seconds]) %></td>
                  <td><%= render "day_swipes", day: day %></td>
                  <td class="text-end"><%= render "day_actions", employee: @selected_employee, day: day %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% @clocking_days.each do |day| %>
          <% next unless day[:correction] %>
          <%= render "admin/corrections/review_modal",
            correction: day[:correction],
            action: :approve,
            day_swipes: day[:day_swipes] %>
          <%= render "admin/corrections/review_modal",
            correction: day[:correction],
            action: :reject,
            day_swipes: day[:day_swipes] %>
        <% end %>

        <% @clocking_days.each do |day| %>
          <% next unless admin_swipes_day_reviewed_corrections?(day) %>
          <%= render "day_corrections_modal", employee: @selected_employee, day: day %>
        <% end %>
      </section>
    <% elsif @search_mode == "category" && @selected_category %>
      <section class="card shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th><%= t(".employee") %></th>
                <th><%= t(".date") %></th>
                <th><%= t(".hours") %></th>
                <th><%= t(".swipes") %></th>
                <th class="text-end"><%= t("shared.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% @category_clocking_days.each do |day| %>
                <% employee = day[:employee] %>
                <% employee_name = employee_display_name(employee) %>
                <tr>
                  <td class="admin-correction-employee-cell">
                    <span class="admin-correction-person">
                      <strong class="admin-correction-person-name" title="<%= employee_name %>"><%= employee_name %></strong>
                      <em class="admin-correction-person-meta" title="<%= employee.national_id %>"><%= employee.national_id %></em>
                    </span>
                  </td>
                  <td class="text-nowrap"><%= l(day[:date], format: :weekday_day_month) %></td>
                  <td class="<%= admin_swipes_hours_cell_class(day) %>"><%= duration_text(day[:worked_seconds]) %></td>
                  <td><%= render "day_swipes", day: day %></td>
                  <td class="text-end"><%= render "day_actions", employee: employee, day: day %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% @category_clocking_days.each do |day| %>
          <% next unless day[:correction] %>
          <%= render "admin/corrections/review_modal",
            correction: day[:correction],
            action: :approve,
            day_swipes: day[:day_swipes] %>
          <%= render "admin/corrections/review_modal",
            correction: day[:correction],
            action: :reject,
            day_swipes: day[:day_swipes] %>
        <% end %>

        <% @category_clocking_days.each do |day| %>
          <% next unless admin_swipes_day_reviewed_corrections?(day) %>
          <%= render "day_corrections_modal", employee: day[:employee], day: day %>
        <% end %>

        <% if @category_clocking_days.empty? %>
          <div class="card-body text-center text-body-secondary">
            <%= t(".category_empty") %>
          </div>
        <% end %>
      </section>

      <%= render "admin/shared/pagination",
        page: @admin_page,
        total_pages: @admin_total_pages,
        previous_page: @admin_previous_page,
        next_page: @admin_next_page,
        path: pagination_path %>
    <% else %>
      <section class="admin-calendar-empty text-center text-body-secondary" aria-live="polite">
        <%= icon "search" %>
        <p class="small mb-0"><%= t(@search_mode == "category" ? ".category_prompt" : ".empty") %></p>
      </section>
    <% end %>
  </div>

  <%= render "admin/shared/list_loading" %>
</div>
