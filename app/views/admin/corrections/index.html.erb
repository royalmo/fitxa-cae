<% content_for :title, t(".title") %>
<% pagination_path = ->(page) { admin_corrections_path(request.query_parameters.except("page").merge(page: page)) } %>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
  <div class="d-flex align-items-center gap-2">
    <%= icon "square-pen", class: "text-primary" %>
    <h1 class="h2 mb-0"><%= t(".heading") %></h1>
  </div>
  <%= link_to new_admin_correction_path, class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
    <%= icon "plus" %>
    <span><%= t(".new_correction") %></span>
  <% end %>
</div>

<div data-controller="list-loading">
  <div class="mb-3">
    <%= form_with url: admin_corrections_path,
      method: :get,
      class: "admin-corrections-filter-form d-flex flex-column gap-2 w-100 mb-2",
      data: { action: "submit->list-loading#showLoading" } do |form| %>
      <div class="admin-corrections-primary-filters d-flex flex-column flex-lg-row align-items-stretch gap-2">
        <div class="admin-corrections-employee-filter">
          <%= form.label :employee_query, t(".employee"), class: "form-label visually-hidden" %>
          <%= render "admin/shared/employee_search",
            form: form,
            field: :employee_id,
            query_field: :employee_query,
            selected_employee: @selected_employee,
            placeholder: t(".employee_search_placeholder"),
            clear_label: t(".all_employees"),
            results_id: "admin-corrections-employee-results" %>
        </div>

        <div class="admin-corrections-tag-filter">
          <%= form.label :tag_query, t(".tag"), class: "form-label visually-hidden" %>
          <%= render "admin/shared/tag_search",
            form: form,
            field: :tag_id,
            query_field: :tag_query,
            selected_tag: @selected_tag,
            placeholder: t(".tag_search_placeholder"),
            clear_label: t(".all_tags"),
            results_id: "admin-corrections-tag-results" %>
        </div>
      </div>

      <div class="admin-corrections-secondary-filters d-flex flex-column flex-xl-row align-items-stretch gap-2">
        <fieldset class="admin-corrections-status-filter btn-group" role="group" aria-label="<%= t(".status") %>">
          <% [ "" ].concat(@filterable_statuses).each do |status| %>
            <% option_id = "admin_correction_status_#{status.presence || "all"}" %>
            <%= form.radio_button :status,
              status,
              id: option_id,
              checked: @selected_status.to_s == status.to_s,
              class: "btn-check",
              autocomplete: "off",
              data: { action: "change->list-loading#filter" } %>
            <%= form.label :status,
              for: option_id,
              class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" do %>
              <%= icon admin_corrections_status_filter_icon(status), class: "admin-badge-icon" %>
              <span><%= admin_corrections_status_filter_label(status) %></span>
            <% end %>
          <% end %>
        </fieldset>

        <div class="admin-corrections-period-filter">
          <span class="admin-corrections-period-label"><%= t(".period_prefix") %></span>

          <div class="admin-corrections-period">
            <%= form.label :month, t(".month"), class: "form-label visually-hidden" %>
            <%= form.label :year, t(".year"), class: "form-label visually-hidden" %>
            <div class="input-group flex-nowrap">
              <%= form.select :month,
                [[t(".all_months"), ""]] + admin_corrections_month_options,
                { selected: @selected_month || "" },
                class: "form-select",
                data: { action: "change->list-loading#filter" } %>
              <span class="input-group-text"><%= t(".period_connector") %></span>
              <%= form.select :year,
                [[t(".all_years"), ""]] + @year_options,
                { selected: @selected_year || "" },
                class: "form-select",
                data: { action: "change->list-loading#filter" } %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <hr class="admin-filters-divider">

    <div class="text-center">
      <%= render "admin/shared/result_count",
        count: @admin_records_count,
        range_start: @admin_records_range_start,
        range_end: @admin_records_range_end %>
    </div>
  </div>

  <div data-list-loading-target="results" data-controller="correction-highlight">
    <section class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="admin-correction-status-cell"><%= t(".status") %></th>
              <th><%= t(".employee") %></th>
              <th><%= t(".date") %></th>
              <th><%= t(".request") %></th>
              <th><%= t(".validator") %></th>
              <th class="text-end"><%= t("shared.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @corrections.each do |correction| %>
              <% highlighted = @highlight_day == correction.day %>
              <% row_options = {
                class: class_names("admin-correction-row", "is-highlighted": highlighted),
                data: { correction_day: correction.day.iso8601 }
              } %>
              <% if highlighted %>
                <% row_options[:data][:correction_highlight_target] = "row" %>
                <% row_options[:tabindex] = "-1" %>
              <% end %>
              <%= tag.tr(**row_options) do %>
                <td class="admin-correction-status-cell">
                  <span class="<%= bootstrap_status_badge_class(correction.status) %>">
                    <%= icon correction_status_icon_name(correction.status), class: "admin-badge-icon" %>
                    <span><%= admin_correction_status_text(correction.status) %></span>
                  </span>
                </td>
                <td class="admin-correction-employee-cell">
                  <% employee_name = employee_display_name(correction.employee) %>
                  <span class="admin-correction-person">
                    <strong class="admin-correction-person-name" title="<%= employee_name %>"><%= employee_name %></strong>
                    <em class="admin-correction-person-meta" title="<%= correction.employee.national_id %>"><%= correction.employee.national_id %></em>
                  </span>
                </td>
                <td class="admin-correction-date-cell"><%= l(correction.day, format: :short) %></td>
                <td class="admin-correction-request-cell">
                  <% day_swipes = @correction_day_swipes_by_key.fetch([correction.employee_id, correction.day], []) %>
                  <% change_items = admin_correction_change_items(correction, day_swipes) %>
                  <% if change_items.any? %>
                    <div class="admin-correction-change-summary" aria-label="<%= change_items.map { |item| admin_correction_change_item_label(item) }.join(" · ") %>">
                      <% change_items.each do |item| %>
                        <span class="<%= class_names("admin-correction-change-item", "is-#{item[:type]}", item[:kind].present? && "is-#{item[:kind]}") %>">
                          <%= icon admin_correction_change_icon_name(item),
                            title: admin_correction_change_icon_title(item),
                            class: "admin-correction-change-icon" %>
                          <span><%= item[:time] %></span>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="small text-body-secondary"><%= t("employee.corrections.summary.no_details") %></span>
                  <% end %>
                </td>
                <td class="admin-correction-validator-cell">
                  <% if correction.validator %>
                    <% validator_name = manager_display_name(correction.validator) %>
                    <span class="admin-correction-validator-name" title="<%= validator_name %>"><%= validator_name %></span>
                  <% else %>
                    <span class="text-body-secondary">—</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <%= link_to admin_correction_path(correction),
                      class: "btn btn-sm btn-outline-secondary admin-row-action",
                      title: t("shared.view"),
                      aria: { label: t("shared.view") } do %>
                      <%= icon "eye" %>
                    <% end %>
                    <% if correction.pending? %>
                      <% [ :approve, :reject ].each do |review_action| %>
                        <button type="button"
                          class="<%= admin_correction_review_button_class(review_action) %>"
                          title="<%= t("shared.#{review_action}") %>"
                          aria-label="<%= t("shared.#{review_action}") %>"
                          data-bs-toggle="modal"
                          data-bs-target="#<%= admin_correction_review_modal_id(correction, review_action) %>">
                          <%= icon(review_action == :approve ? "check" : "x") %>
                        </button>
                      <% end %>
                      <%= link_to edit_admin_correction_path(correction),
                        class: "btn btn-sm btn-outline-secondary admin-row-action",
                        title: t("shared.edit"),
                        aria: { label: t("shared.edit") } do %>
                        <%= icon "pencil" %>
                      <% end %>
                    <% else %>
                      <%= link_to new_admin_correction_path(employee_id: correction.employee_id, day: correction.day.iso8601),
                        class: "btn btn-sm btn-outline-secondary admin-row-action",
                        title: t(".new_correction"),
                        aria: { label: t(".new_correction") } do %>
                        <%= icon "plus" %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% @corrections.each do |correction| %>
        <% next unless correction.pending? %>
        <% day_swipes = @correction_day_swipes_by_key.fetch([correction.employee_id, correction.day], []) %>
        <%= render "review_modal", correction: correction, action: :approve, day_swipes: day_swipes %>
        <%= render "review_modal", correction: correction, action: :reject, day_swipes: day_swipes %>
      <% end %>

      <% if @corrections.empty? %>
        <div class="card-body text-center text-body-secondary">
          <%= t(".empty") %>
        </div>
      <% end %>
    </section>

    <%= render "admin/shared/pagination",
      page: @admin_page,
      total_pages: @admin_total_pages,
      previous_page: @admin_previous_page,
      next_page: @admin_next_page,
      path: pagination_path %>
  </div>

  <%= render "admin/shared/list_loading" %>
</div>
