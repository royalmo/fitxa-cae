<p style="<%= mailer_style(:paragraph) %>"><%= t("mailers.shared.greeting_prefix") %> <strong><%= @manager_name %></strong>,</p>

<p style="<%= mailer_style(:paragraph) %>"><%= t(".body") %></p>

<p style="<%= mailer_style(:button_wrap) %>"><%= link_to t(".button"), @password_url, style: mailer_style(:button) %></p>

<p style="<%= mailer_style(:help) %>">
  <%= t("mailers.shared.password_fallback") %><br>
  <%= link_to @password_url, @password_url, style: mailer_style(:fallback_link) %>
</p>

<p style="<%= mailer_style(:paragraph) %>"><%= t(".expires") %></p>

<p style="<%= mailer_style(:paragraph) %>">
  <%= t("mailers.shared.signoff") %><br>
  <%= t("mailers.shared.platform_signature", app_name: app_name) %>
</p>
