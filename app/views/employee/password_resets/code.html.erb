<% content_for :title, t(".title") %>
<% submitted_code = params[:code].presence || Array(params[:code_digits]).join %>

<section class="auth-card auth-card-narrow employee-auth-card">
  <header class="auth-header">
    <%= render "layouts/brand_mark", path: login_path %>
    <h1><%= t(".heading") %></h1>
    <p class="auth-code-help">
      <span><%= t(".sent_if_found_intro") %></span>
      <span><%= t(".sent_if_found.#{@delivery_method}") %></span>
    </p>
  </header>

  <section class="auth-panel">
    <div class="auth-panel-actions">
      <%= link_to new_employee_password_reset_path(delivery_method: @delivery_method), class: "auth-back-link" do %>
        <%= icon "arrow-left", class: "icon" %>
        <span><%= t(".back") %></span>
      <% end %>
    </div>

    <%= render "employee/sessions/flash_messages" %>

    <%= render "employee/sessions/code_form",
      form_url: verify_employee_password_reset_code_path,
      submitted_code: submitted_code,
      code_label: t(".code"),
      digit_label_key: "employee.password_resets.code.digit",
      field_id_prefix: "password_reset_code",
      submit_label: t(".submit"),
      submitting_label: t(".submitting") %>
  </section>
</section>
