<p><%= t("mailers.shared.greeting_prefix") %> <strong><%= @employee_name %></strong>,</p>

<p>
  <%= t(".account_created_prefix") %>
  <%= link_to app_name, @app_url %>:
  <%= t(".account_created_suffix") %>
</p>

<p><%= t("mailers.shared.create_password_intro") %></p>

<p><%= link_to t("mailers.shared.create_password_button"), @password_url, class: "mailer-button" %></p>

<p class="mailer-help">
  <%= t("mailers.shared.password_fallback") %><br>
  <%= link_to @password_url, @password_url, class: "mailer-fallback-link" %>
</p>

<p><%= t("mailers.shared.password_setup_expires") %></p>

<p><%= t(".contact") %></p>

<p>
  <%= t("mailers.shared.signoff") %><br>
  <%= t("mailers.shared.platform_signature", app_name: app_name) %>
</p>
