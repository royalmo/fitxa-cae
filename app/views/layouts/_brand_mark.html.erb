<%= link_to local_assigns.fetch(:path), class: class_names("brand-mark", local_assigns[:class]), aria: { label: app_name } do %>
  <span class="brand-wordmark">
    <span class="brand-fitxa"><%= app_brand_prefix %></span>
    <% if local_assigns[:badge].present? %>
      <span class="brand-badge"><%= local_assigns[:badge] %></span>
    <% end %>
  </span>
  <% if app_brand_logo_asset.present? %>
    <%= image_tag app_brand_logo_asset, alt: app_brand_suffix, class: "brand-logo" %>
  <% elsif app_brand_suffix.present? %>
    <span class="brand-text-suffix"><%= app_brand_suffix %></span>
  <% end %>
<% end %>
