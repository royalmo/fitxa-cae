<% selected_employee ||= nil %>
<% field ||= :employee_id %>
<% query_field ||= :employee_query %>
<% results_id ||= "admin-employee-search-results" %>
<% placeholder ||= t("admin.shared.employee_search.placeholder") %>
<% clear_label ||= t("admin.shared.employee_search.clear") %>
<% disabled = local_assigns.fetch(:disabled, false) %>
<% clearable = local_assigns.fetch(:clearable, true) && !disabled %>
<% auto_submit = local_assigns.fetch(:auto_submit, true) %>
<% hidden_data = { employee_search_target: "employeeId" }.merge(local_assigns.fetch(:hidden_data, {})) %>
<% input_data = {
  employee_search_target: "input",
  action: "input->employee-search#search focus->employee-search#search keydown->employee-search#keydown"
} %>

<div
  class="admin-employee-search position-relative"
  data-controller="employee-search"
  data-employee-search-url-value="<%= admin_employee_search_path %>"
  data-employee-search-auto-submit-value="<%= auto_submit %>">
  <%= form.hidden_field field,
    value: (selected_employee&.id).to_s,
    data: hidden_data %>
  <div class="input-group">
    <span class="input-group-text"><%= icon "search" %></span>
    <%= text_field_tag query_field,
      selected_employee ? employee_display_name(selected_employee) : nil,
      class: "form-control",
      placeholder: placeholder,
      autocomplete: "off",
      disabled: disabled,
      role: "combobox",
      aria: {
        autocomplete: "list",
        controls: results_id,
        expanded: "false"
      },
      data: input_data %>
    <% if clearable %>
      <button
        type="button"
        class="btn btn-outline-secondary"
        title="<%= clear_label %>"
        aria-label="<%= clear_label %>"
        data-action="employee-search#clear">
        <%= icon "x" %>
      </button>
    <% end %>
  </div>
  <div
    id="<%= results_id %>"
    class="admin-employee-search-results list-group shadow-sm"
    data-employee-search-target="results"
    role="listbox"
    hidden></div>
</div>
